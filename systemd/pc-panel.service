[Unit]
# give up after 10 failures in 2 minutes (for example the port is taken) instead of looping forever
StartLimitIntervalSec=120
StartLimitBurst=10
Description=PC Panel, local web dashboard (port 47822 unless changed in the tray icon)

[Service]
ExecStart=@BIN@
# if the panel stops, a custom graphics card fan curve falls back to the factory curve
ExecStopPost=@BIN@ --on-stop
Restart=on-failure
RestartSec=5
# never compete with a game: only runs on idle processor and disk time
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
MemoryMax=200M

[Install]
WantedBy=default.target
