# ---------------------------------------------------------------- state

trava = threading.Lock()
novo = threading.Condition()
acordar = threading.Event()
sino = threading.Condition()            # wakes the slower loops when the page opens or settings change


def despertar():
    acordar.set()
    with sino:
        sino.notify_all()


def cochilar(seg):
    # sleep up to seg seconds, or less when the page opens or the settings change
    with sino:
        sino.wait(seg)
hist = collections.deque(maxlen=700)        # 11 minutes even when sampling every 1 s
