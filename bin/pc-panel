PASTA_CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "pc-panel")


def porta_salva():
    # PC_PANEL_PORT wins, then the port chosen in the tray icon (~/.config/pc-panel/port), then 47822
    try:
        p = int(os.environ.get("PC_PANEL_PORT") or open(os.path.join(PASTA_CFG, "port")).read().strip())
        if 1024 <= p <= 65535:
            return p
    except (OSError, ValueError):
        pass
    return 47822


ENDERECO, PORTA = "127.0.0.1", porta_salva()
