trava_ev = threading.Lock()         # open events and silences change from the sampling and the web threads
ev_seq = [0]
cfg_seq = [0]
cfg = {}


def assistindo(limite=20):
    return time.time() - visto[0] < limite


def ritmo():
    # (seconds between samples, page open?) or (None, False) to sleep
    if assistindo():
        return passo_pagina(), True
    lento = []
    if cfg["alertas"]["fundo"]:
        lento.append(cfg["alertas"]["cada"])
    if cfg["registro"]["ligado"]:
        lento.append(cfg["registro"]["intervalo"])
    if cfg["caixa"]:
        lento.append(10)
    f = cfg["fans"]
    if fans["pode"] and f:
        if f["gpu"]["modo"] == "curva":
            lento.append(4)         # the graphics card curve is driven from here
        if f["gpu"]["modo"] == "fixo" or any(x["modo"] == "fixo" for x in f["placa"].values()):
            lento.append(10)        # fixed fan speed: keep an eye on the temperature
    return (float(min(lento)), False) if lento else (None, False)


def passo_pagina():
    # with a game running the open page samples every 5 s at most, every frame counts
    p = float(cfg["passo"])
    return max(p, 5.0) if cfg["jogo"]["leve"] and extra["jogos"] else p


# ---------------------------------------------------------------- settings

def cfg_padrao():
    return {"idioma": "pt" if os.environ.get("LANG", "").startswith("pt") else "en", "tema": "escuro", "cor": "azul", "fonte": 1, "passo": 2, "perfil": "tudo",
            "cartoes": {c: True for c in CARTOES}, "encaixe": True, "ping_alvo": "1.1.1.1",
            "avisar": {"desktop": False, "som": False, "nivel": "serio"},
            # keep measuring with the page closed so the tray icon and notifications can warn
            "alertas": {"fundo": True, "cada": 10},
            "limites": {m: ({"on": True, "nv": NIVEL_EVENTO.get(m, "aviso")} if d[0] == "evento" else {"on": True, "rec": True, "v": None})
                        for m, d in METRICAS.items()},
            # thresholds used while a game runs (on/off still comes from "limites")
            "limites_jogo": {m: {"rec": True, "v": None} for m, d in METRICAS.items() if d[0] != "evento"},
            # limites: use limites_jogo while gaming; leve: open page samples every 5 s while gaming
            "jogo": {"limites": True, "leve": True},
            # tray tooltip with a few readings, rewritten every 30 s at most
            "dica": True,
            # black box and 24 h history: keep sampling every 10 s with the page closed
            "caixa": True,
            "registro": {"ligado": False, "pasta": "~/.local/share/pc-panel/registro", "intervalo": 10, "dias": 30},
            # extra modules, off by default: Project Zomboid server and live viewer counter
            "modulos": {"zomboid": False, "live": False},
            # MiB subtracted from available memory (3500 mimics the MangoHud "RAM LEFT" row)
            "ram_reserva": 0,
            "fans": None, "canais": [], "calib": {}, "nomes_fans": {}}


def limpar_cfg(d, base):
    # merges what came in (d) over the current settings (base);
    # returns (valid settings, None) or (None, (error in Portuguese, error in English))
    nova = copia(base)
    if not isinstance(d, dict):
        return nova, None
    for chave, validos in (("idioma", ("pt", "en")), ("tema", TEMAS), ("cor", CORES), ("fonte", (1, 1.15, 1.3)),
                           ("passo", (1, 2, 5)), ("perfil", PERFIS)):
        if not isinstance(d.get(chave), bool) and d.get(chave) in validos:
            nova[chave] = d[chave]
    if isinstance(d.get("cartoes"), dict):
        for c in CARTOES:
            if c in d["cartoes"]:
                nova["cartoes"][c] = bool(d["cartoes"][c])
    if "encaixe" in d:
        nova["encaixe"] = bool(d["encaixe"])
    if isinstance(d.get("avisar"), dict):
        for k in ("desktop", "som"):
            if k in d["avisar"]:
                nova["avisar"][k] = bool(d["avisar"][k])
        if d["avisar"].get("nivel") in NIVEIS[1:]:
            nova["avisar"]["nivel"] = d["avisar"]["nivel"]
    if isinstance(d.get("alertas"), dict):
        if "fundo" in d["alertas"]:
            nova["alertas"]["fundo"] = bool(d["alertas"]["fundo"])
        if d["alertas"].get("cada") in (5, 10, 30, 60):
            nova["alertas"]["cada"] = d["alertas"]["cada"]
    for chave in ("limites", "limites_jogo"):
        if isinstance(d.get(chave), dict):
            falha = limpar_limites(d[chave], nova[chave])
            if falha:
                return None, falha
    if isinstance(d.get("jogo"), dict):
        for k in ("limites", "leve"):
            if k in d["jogo"]:
                nova["jogo"][k] = bool(d["jogo"][k])
    for k in ("dica", "caixa"):
        if k in d:
            nova[k] = bool(d[k])
    if isinstance(d.get("modulos"), dict):
        for k in ("zomboid", "live"):
            if k in d["modulos"]:
                nova["modulos"][k] = bool(d["modulos"][k])
    if numero(d.get("ram_reserva")):
        nova["ram_reserva"] = int(min(16000, max(0, d["ram_reserva"])))
    alvo = d.get("ping_alvo")
    if isinstance(alvo, str) and alvo.strip():
        alvo = alvo.strip()
        if not RE_IP.fullmatch(alvo) or any(int(x) > 255 for x in alvo.split(".")):
            return None, ("O endereço do ping precisa ser um IP, por exemplo 1.1.1.1",
                          "The ping address must be an IP, for example 1.1.1.1")
        nova["ping_alvo"] = alvo
    r = d.get("registro")
    if isinstance(r, dict):
        if "ligado" in r:
            nova["registro"]["ligado"] = bool(r["ligado"])
        if r.get("intervalo") in (5, 10, 30, 60):
            nova["registro"]["intervalo"] = r["intervalo"]
        if r.get("dias") in (0, 7, 30, 90, 365):
            nova["registro"]["dias"] = r["dias"]
        if isinstance(r.get("pasta"), str) and r["pasta"].strip():
            pasta = r["pasta"].strip()
            if not os.path.isabs(os.path.expanduser(pasta)):
                return None, ("A pasta do registro precisa ser um caminho completo, por exemplo /mnt/data/pc-panel",
                              "The log folder must be a full path, for example /mnt/data/pc-panel")
            nova["registro"]["pasta"] = pasta
    if nova["registro"]["ligado"]:
        real = os.path.expanduser(nova["registro"]["pasta"])
        try:
            os.makedirs(real, exist_ok=True)
            teste = os.path.join(real, ".teste-pc-panel")
            open(teste, "w").close()
            os.remove(teste)
        except OSError as e:
            return None, ("Não consegui gravar na pasta %s (%s)" % (real, e.strerror),
                          "Could not write to the folder %s (%s)" % (real, e.strerror))
    return nova, None


def limpar_limites(entrada, destino):
    # validates thresholds in place; returns None or (error in Portuguese, error in English)
    for m, x in entrada.items():
        if m not in destino or not isinstance(x, dict):
            continue
        direcao, menor, maior = METRICAS[m]
        alvo = destino[m]
        if "on" in x and "on" in alvo:
            alvo["on"] = bool(x["on"])
        if direcao == "evento":
            if x.get("nv") in NIVEIS[1:]:
                alvo["nv"] = x["nv"]
            continue
        if "rec" in x:
            alvo["rec"] = bool(x["rec"])
        v = x.get("v")
        if v is None:
            continue
        if not (isinstance(v, list) and len(v) == 3 and all(y is None or numero(y) for y in v)):
            return "Limite inválido em %s" % m, "Invalid threshold in %s" % m
        usados = [y for y in v if y is not None]
        if any(not menor <= y <= maior for y in usados):
            return ("Os limites de %s precisam ficar entre %s e %s" % (m, menor, maior),
                    "The %s thresholds must be between %s and %s" % (m, menor, maior))
        if usados != sorted(usados, reverse=direcao == "baixo") or len(set(usados)) != len(usados):
            return ("Os limites de %s precisam %s de atenção para crítico" % (m, "descer" if direcao == "baixo" else "subir"),
                    "The %s thresholds must %s from warning to critical" % (m, "go down" if direcao == "baixo" else "go up"))
        if not usados and not alvo["rec"]:
            return ("Preencha pelo menos um limite de %s ou desligue o alerta" % m,
                    "Fill at least one %s threshold or turn the alert off" % m)
        alvo["v"] = v
    return None


def carregar_cfg():
    global cfg
    try:
        salvo = json.loads(ler(ARQ_CFG) or "null")
    except ValueError:
        salvo = None
    nova, erro = limpar_cfg(salvo, cfg_padrao())
    if erro:                        # log folder is gone: carry on without logging
        avisar("config", erro[0])
        salvo["registro"]["ligado"] = False
        nova, erro = limpar_cfg(salvo, cfg_padrao())
    if isinstance(salvo, dict):     # parts only this program writes
        if isinstance(salvo.get("canais"), list):
            nova["canais"] = [c for c in salvo["canais"] if c in tuple("1234567")]
        if isinstance(salvo.get("calib"), dict):
            nova["calib"] = salvo["calib"]
        if isinstance(salvo.get("nomes_fans"), dict):
            nova["nomes_fans"] = {k: str(v)[:24] for k, v in salvo["nomes_fans"].items()}
        nova["fans"] = salvo.get("fans")
    cfg = nova


def salvar_cfg(nova):
    global cfg
    os.makedirs(PASTA_CFG, exist_ok=True)
    with open(ARQ_CFG + ".novo", "w") as f:
        json.dump(nova, f, indent=1, ensure_ascii=False)
    os.replace(ARQ_CFG + ".novo", ARQ_CFG)
    cfg = nova
    cfg_seq[0] += 1


# ---------------------------------------------------------------- logging to file

class Registro:
    COLUNAS = ["hora", "ram_usada_gib", "ram_left_mib", "swap_gib", "vram_gib", "placa_uso", "placa_temp",
               "placa_watts", "placa_fan", "cpu_uso", "cpu_temp", "fans_rpm", "ping_ms", "download_mbit",
               "upload_mbit", "jogo", "jogo_ram_gib", "jogo_vram_gib", "espectadores", "pz_ticks", "pz_jogadores"]

    def __init__(self):
        self.f = self.caminho = self.erro = None
        self.proxima = self.limpeza = 0.0

    def pasta(self):
        return os.path.expanduser(cfg["registro"]["pasta"])

    def fechar(self):
        if self.f:
            try:
                self.f.close()
            except OSError:
                pass
        self.f = self.caminho = None

    def abrir(self, nome, cabecalho):
        os.makedirs(self.pasta(), exist_ok=True)
        caminho = os.path.join(self.pasta(), nome)
        vazio = not os.path.exists(caminho) or os.path.getsize(caminho) == 0
        f = open(caminho, "a", newline="", encoding="utf-8")
        if vazio:
            csv.writer(f).writerow(cabecalho)
        return f

    def medida(self, a):
        if not cfg["registro"]["ligado"]:
            self.fechar()
            return
        agora = time.monotonic()
        if agora < self.proxima:
            return
        self.proxima = agora + cfg["registro"]["intervalo"] - 0.3
        try:
            nome = time.strftime("painel-%Y-%m-%d.csv")
            caminho = os.path.join(self.pasta(), nome)
            if caminho != self.caminho or not os.path.exists(caminho):
                self.fechar()
                self.f, self.caminho = self.abrir(nome, self.COLUNAS), caminho
            csv.writer(self.f).writerow(self.linha(a))
            self.f.flush()
            self.erro = None
            if agora >= self.limpeza:
                self.limpeza = agora + 3600
                self.limpar()
        except OSError as e:
            self.erro = e.strerror or str(e)
            self.fechar()

    def linha(self, a):
        def n(v, casas=1):
            return "" if v is None else round(v, casas)

        g, r, c, rd, lv, z = a["gpu"], a["ram"], a["cpu"], a["rede"], a["live"], a["pz"]
        j = a["jogos"][0] if a["jogos"] else None
        ping = rd["ping"]
        vivas = [v for v in (lv.get("twitch"), lv.get("youtube"), lv.get("kick")) if isinstance(v, int)]
        return [time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(a["t"])),
                n(r["usada"] / 1048576, 2), r["left"] // 1024, n(r["swap"] / 1048576, 2),
                n(g["vram"] / 1024, 2) if g["ok"] else "", g.get("uso", ""), g.get("temp", ""),
                g.get("watts", ""), g.get("fan", ""), n(c["uso"]), n(c["temp"]),
                " ".join(str(x["rpm"]) for x in a["fans"]["canais"]),
                "" if ping is None else "perdido" if ping < 0 else ping,
                n(None if rd["rx"] is None else rd["rx"] * 8 / 1e6, 2),
                n(None if rd["tx"] is None else rd["tx"] * 8 / 1e6, 2),
                j["nome"] if j else "", n(j["kb"] / 1048576, 2) if j else "", n(j["vram"] / 1024, 2) if j else "",
                sum(vivas) if vivas else "", n(z["ticks"]) if z else "",
                len(z["jogadores"]) if z and z["jogadores"] is not None else ""]

    def evento(self, tipo, ev):
        if not cfg["registro"]["ligado"]:
            return
        try:
            with self.abrir("eventos.csv", ["hora", "tipo", "nivel", "texto", "jogo", "duracao_s"]) as f:
                quando = ev["fim"] if tipo == "fim" else ev["t"]
                csv.writer(f).writerow([time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(quando)), tipo, ev["nv"],
                                        ev[cfg["idioma"]], ev["jogo"] or "",
                                        round(ev["fim"] - ev["t"]) if ev["fim"] else ""])
        except OSError as e:
            self.erro = e.strerror or str(e)

    def limpar(self):
        dias = cfg["registro"]["dias"]
        if not dias:
            return
        corte = time.strftime("painel-%Y-%m-%d.csv", time.localtime(time.time() - dias * 86400))
        for arq in glob.glob(os.path.join(glob.escape(self.pasta()), "painel-????-??-??.csv")):
            if os.path.basename(arq) < corte:
                os.remove(arq)

    def info(self):
        pasta = self.pasta()
        arqs = [a for a in glob.glob(os.path.join(glob.escape(pasta), "*.csv"))
                if re.fullmatch(r"painel-\d{4}-\d\d-\d\d\.csv|eventos\.csv", os.path.basename(a))]
        hoje = time.strftime("painel-%Y-%m-%d.csv")
        return {"pasta": pasta, "arquivos": len(arqs), "bytes": sum(os.path.getsize(a) for a in arqs),
                "hoje": hoje if os.path.exists(os.path.join(pasta, hoje)) else None, "erro": self.erro}


registro = Registro()

# ---------------------------------------------------------------- warnings and events

abertos, pendentes = {}, {}


def notificar(ev):
    # desktop notification, only when enabled in Settings
    if not cfg["avisar"]["desktop"] or NIVEIS.index(ev["nv"]) < NIVEIS.index(cfg["avisar"]["nivel"]):
        return
    args = ["busctl", "--user", "call", "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
            "org.freedesktop.Notifications", "Notify", "susssasa{sv}i", "PC Panel", "0",
            "dialog-warning" if ev["nv"] == "aviso" else "dialog-error", "PC Panel", ev[cfg["idioma"]],
            "0", "0", "10000"]
    threading.Thread(target=rodar, args=(args, 5), daemon=True).start()


def acompanhar(avisos, t, jogo):
    # a warning becomes an event after 2 samples in a row and closes after 3 good samples
    vistos = set()
    for a in avisos:
        ident = a["id"]
        vistos.add(ident)
        aberto = abertos.get(ident)
        if aberto:
            aberto["ok"] = 0
            antes = NIVEIS.index(aberto["ev"]["nv"])
            if NIVEIS.index(a["nv"]) > antes:
                aberto["ev"].update(nv=a["nv"], pt=a["pt"], en=a["en"])
                ev_seq[0] += 1
                if antes < NIVEIS.index(cfg["avisar"]["nivel"]):
                    notificar(aberto["ev"])   # it just got bad enough to notify
            continue
        pendentes[ident] = pendentes.get(ident, 0) + 1
        if pendentes[ident] >= 2:
            ev = {"t": round(t), "fim": None, "nv": a["nv"], "pt": a["pt"], "en": a["en"], "jogo": jogo, "c": a["c"], "id": ident}
            eventos.append(ev)
            abertos[ident] = {"ev": ev, "ok": 0}
            del pendentes[ident]
            ev_seq[0] += 1
            registro.evento("comeco", ev)
            notificar(ev)
    for ident in [i for i in pendentes if i not in vistos]:
        del pendentes[ident]
    for ident in [i for i in abertos if i not in vistos]:
        aberto = abertos[ident]
        aberto["ok"] += 1
        if aberto["ok"] >= 3:
            aberto["ev"]["fim"] = round(t)
            del abertos[ident]
            ev_seq[0] += 1
            registro.evento("fim", aberto["ev"])


ARQ_ALERTA = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "pc-panel", "alert")
bandeja = {"ult": None}


def avisar_bandeja():
    # The tray icon watches this small file (inotify, no polling): first line is the worst
    # level now (0 ok, 1 warning, 2 serious, 3 critical), then one line per problem.
    # One-off events (kernel error, crash) stay for 10 minutes.
    agora = time.time()
    lista = [a["ev"] for a in list(abertos.values())] + [e for e in list(eventos) if e["fim"] == e["t"] and agora - e["t"] < 600
                                                         and not e.get("mudo")]
    lista.sort(key=lambda e: -NIVEIS.index(e["nv"]))
    pior = NIVEIS.index(lista[0]["nv"]) if lista else 0
    corpo = "%d\n%s" % (pior, "".join(e[cfg["idioma"]].replace("\n", " ")[:120] + "\n" for e in lista[:5]))
    if corpo == bandeja["ult"]:
        return
    try:
        os.makedirs(os.path.dirname(ARQ_ALERTA), exist_ok=True)
        with open(ARQ_ALERTA + ".new", "w") as f:
            f.write(corpo)
        os.replace(ARQ_ALERTA + ".new", ARQ_ALERTA)
        bandeja["ult"] = corpo
    except OSError as e:
        avisar("bandeja", e)


def evento_avulso(nv, pt, en, cartao="saude"):
    t = round(time.time())
    jogo = extra["jogos"][0]["nome"] if extra["jogos"] else None
    ev = {"t": t, "fim": t, "nv": nv, "pt": pt, "en": en, "jogo": jogo, "c": cartao}
    if silenciado("*", t):
        ev["mudo"] = True               # kept in the list, but no tray colour or notification
    eventos.append(ev)
    ev_seq[0] += 1
    registro.evento("fim", ev)
    if not ev.get("mudo"):
        notificar(ev)
    avisar_bandeja()


def silenciar(ident, minutos):
    # silence one alert (or all, "*") for a while; an open event closes now
    t = time.time()
    with trava_ev:
        _silenciar(ident, minutos, t)
    avisar_bandeja()


def _silenciar(ident, minutos, t):
    if minutos:
        silencio[ident] = t + minutos * 60
    else:
        silencio.pop(ident, None)
    for k in [k for k, v in silencio.items() if v <= t]:
        del silencio[k]
    if minutos:
        for i in [i for i in abertos if ident in ("*", i)]:
            abertos[i]["ev"]["fim"] = round(t)
            registro.evento("fim", abertos.pop(i)["ev"])
        for i in [i for i in pendentes if ident in ("*", i)]:
            del pendentes[i]
    ev_seq[0] += 1


def gravar_json(arq, dados):
    os.makedirs(os.path.dirname(arq), exist_ok=True)
    with open(arq + ".novo", "w") as f:
        json.dump(dados, f, separators=(",", ":"), ensure_ascii=False)
    os.replace(arq + ".novo", arq)


# ---------------------------------------------------------------- black box, 24 h history, game sessions

PASTA_ESTADO = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "pc-panel")
PASTA_DADOS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "pc-panel")
ARQ_CAIXA = PASTA_ESTADO + "/caixa-preta.bin"
ARQ_CAIXA_OK = PASTA_ESTADO + "/caixa-preta.ok"
ARQ_INCIDENTES = PASTA_ESTADO + "/incidentes.json"
ARQ_H24 = PASTA_ESTADO + "/historico-24h.json"
ARQ_SSD = PASTA_ESTADO + "/ssd.json"
ARQ_SSD_RITMO = PASTA_ESTADO + "/ssd-ritmo.json"
ARQ_SESSOES = PASTA_DADOS + "/sessoes.jsonl"
ARQ_DICA = os.path.join(os.path.dirname(ARQ_ALERTA), "tip")
BOOT_ID = (ler("/proc/sys/kernel/random/boot_id") or "?").strip().replace("-", "")[:12]


def resumo_amostra(a):
    # the few numbers kept per sample by the black box and the 24 h history
    g, c, r = a["gpu"], a["cpu"], a["ram"]
    top = ((a.get("progs") or {}).get("cpu") or [None])[0]
    return {"t": round(a["t"]), "cpu": c["uso"], "tc": c["temp"], "ghz": c["ghz"], "carga": c["carga"],
            "gpu": g.get("uso"), "tg": g.get("temp"), "w": g.get("watts"),
            "vr": g.get("vram"), "vt": g.get("vram_total"), "ram": r["left"] // 1024, "sw": r["swap"] // 1024,
            "swr": r["swap_mibs"], "pm": r["psi"], "pio": a["psi_io"], "ping": a["rede"]["ping"],
            "pl": a["rede"]["perda"], "jt": a["rede"]["osc"], "fps": (a.get("fps") or {}).get("fps"),
            "cw": c.get("watts"),
            "rx": None if a["rede"]["rx"] is None else round(a["rede"]["rx"] * 8 / 1e6, 2),
            "tx": None if a["rede"]["tx"] is None else round(a["rede"]["tx"] * 8 / 1e6, 2),
            "j": (a["jogos"][0]["nome"][:32] if a["jogos"] else None),
            "top": [top["nome"][:24], round(top["pct"] / NCPU)] if top else None,
            "fan": max([x["rpm"] for x in a["fans"]["canais"]] or [None], key=lambda x: x or 0),
            "de": max([d["espera"] or 0 for d in a["discos"]] or [0]),
            "nv": max([NIVEIS.index(x["nv"]) for x in a["avisos"]] or [0])}


class CaixaPreta:
    # The last minutes kept on disk, in a file that never changes size (360 slots of
    # 512 bytes: 30 minutes at one record every 5 s, 60 at every 10 s). Each record is
    # written in place and synced from its own thread, so after a freeze or a power cut
    # the newest one is at most one sample old, and a slow disk never holds up sampling.
    # A clean stop leaves a marker; a record from an earlier boot without one means the
    # PC stopped on its own, and those last minutes are kept as an incident.
    # Writes go straight to the disk (O_DIRECT, one 4 KiB block): through the page cache a
    # 512 byte write plus sync costs a whole large folio, measured 118 KiB each on ext4.
    SLOTS, TAM, CADA, BLOCO = 360, 512, 5.0, 4096

    def __init__(self):
        self.fd = None
        self.direto = None
        self.espelho = None
        self.buf = None
        self.n = 0
        self.ult = 0.0
        self.fila = None
        self.cond = threading.Condition()
        self.incidentes = []
        self.novo = None

    def iniciar(self):
        try:
            self.incidentes = json.loads(ler(ARQ_INCIDENTES) or "[]")
        except ValueError:
            self.incidentes = []
        recs = []
        try:
            with open(ARQ_CAIXA, "rb") as f:
                bruto = f.read()
            for i in range(0, len(bruto), self.TAM):
                try:
                    r = json.loads(bruto[i:i + self.TAM].strip(b" \n\0") or b"null")
                except ValueError:
                    continue
                if isinstance(r, dict) and isinstance(r.get("s"), int):
                    recs.append(r)
        except OSError:
            pass
        ok = (ler(ARQ_CAIXA_OK) or "").strip()
        if recs:
            recs.sort(key=lambda r: r["s"])
            ult = recs[-1]
            self.n = ult["s"] + 1
            if ult.get("b") != BOOT_ID and ok != ult.get("b"):
                self.guardar([r for r in recs if r.get("b") == ult.get("b")])
        try:
            os.remove(ARQ_CAIXA_OK)
        except OSError:
            pass
        try:
            os.makedirs(PASTA_ESTADO, exist_ok=True)
            self.fd = os.open(ARQ_CAIXA, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
            if os.fstat(self.fd).st_size != self.SLOTS * self.TAM:
                # written once with real bytes, so later writes never allocate blocks
                os.ftruncate(self.fd, 0)
                os.pwrite(self.fd, (b" " * (self.TAM - 1) + b"\n") * self.SLOTS, 0)
                os.fsync(self.fd)
            self.espelho = bytearray(os.pread(self.fd, self.SLOTS * self.TAM, 0))
        except OSError as e:
            avisar("caixa", e)
            self.fd = None
            return
        try:
            self.direto = os.open(ARQ_CAIXA, os.O_WRONLY | os.O_DIRECT | os.O_DSYNC | os.O_CLOEXEC)
            self.buf = mmap.mmap(-1, self.BLOCO)    # page aligned, as O_DIRECT needs
        except (OSError, AttributeError):
            self.direto = None
        threading.Thread(target=self.laco, daemon=True).start()

    def guardar(self, recs):
        u = recs[-1]
        inc = {"id": str(u["t"]), "t": u["t"], "inicio": recs[0]["t"], "detectado": round(time.time()),
               "n": len(recs), "registros": recs}
        self.incidentes = ([inc] + [x for x in self.incidentes if x.get("id") != inc["id"]])[:10]
        try:
            gravar_json(ARQ_INCIDENTES, self.incidentes)
        except OSError as e:
            avisar("caixa", e)
        self.novo = u["t"]              # the event is raised once the settings are loaded

    def avisar_novo(self):
        if self.novo is None:
            return
        k, quando = cfg["limites"]["parou"], time.localtime(self.novo)
        self.novo = None
        if k["on"]:
            evento_avulso(k["nv"], time.strftime("O PC parou sem desligar normalmente em %d/%m às %H:%M:%S "
                                                 "(travamento, queda de energia ou reset). A caixa preta guardou os últimos minutos.", quando),
                          time.strftime("The PC stopped without a normal shutdown on %m/%d at %H:%M:%S "
                                        "(freeze, power cut or reset). The black box kept the last minutes.", quando))

    def anotar(self, a):
        if self.fd is None or a["t"] - self.ult < self.CADA - 0.5:
            return
        self.ult = a["t"]
        r = dict(resumo_amostra(a), b=BOOT_ID, s=self.n)
        dados = json.dumps(r, separators=(",", ":"), ensure_ascii=False).encode()
        if len(dados) > self.TAM - 1:
            r.update(j=None, top=None)
            dados = json.dumps(r, separators=(",", ":")).encode()
        with self.cond:
            self.fila = (self.n % self.SLOTS, dados.ljust(self.TAM - 1) + b"\n")
            self.n += 1
            self.cond.notify()

    def laco(self):
        while True:
            with self.cond:
                while self.fila is None:
                    self.cond.wait()
                slot, dados = self.fila
                self.fila = None
            ini = slot * self.TAM
            self.espelho[ini:ini + self.TAM] = dados
            if self.direto is not None:
                b = ini // self.BLOCO * self.BLOCO
                self.buf[:] = self.espelho[b:b + self.BLOCO]
                try:
                    os.pwrite(self.direto, self.buf, b)
                    continue
                except OSError:
                    os.close(self.direto)    # a file system without O_DIRECT: use the page cache
                    self.direto = None
            try:
                os.pwrite(self.fd, dados, ini)
                os.fdatasync(self.fd)
            except OSError as e:
                avisar("caixa", e)

    def lista(self):
        return [{k: x[k] for k in ("id", "t", "inicio", "detectado", "n")} for x in self.incidentes]

    def um(self, ident):
        return next((x for x in self.incidentes if x.get("id") == ident), None)


def caixa_ok():
    # clean stop: the next start must not take the old records for a freeze
    try:
        os.makedirs(PASTA_ESTADO, exist_ok=True)
        with open(ARQ_CAIXA_OK, "w") as f:
            f.write(BOOT_ID)
    except OSError:
        pass


class Historico24:
    # one line per minute for the last 24 hours (averages and peaks), saved every 15 minutes
    COLS = ["t", "cpu", "cpu_max", "tc_max", "gpu", "gpu_max", "tg_max", "w_max", "vram_max", "ram_min",
            "swap_max", "ping", "ping_max", "jogo", "nv", "perda_max", "jit", "rx", "tx", "fps", "fps_min"]

    def __init__(self):
        self.linhas = collections.deque(maxlen=1440)
        self.trava = threading.Lock()
        self.minuto = None
        self.acc = None
        self.mudou = False

    def carregar(self):
        try:
            d = json.loads(ler(ARQ_H24) or "null")
            if isinstance(d, dict) and isinstance(d.get("cols"), list) and "t" in d["cols"]:
                # columns are matched by name, so a file from an older version still loads
                pos = [d["cols"].index(k) if k in d["cols"] else None for k in self.COLS]
                limite_t = time.time() - 86400
                for x in d["linhas"]:
                    if isinstance(x, list) and len(x) == len(d["cols"]) and x[0] >= limite_t:
                        self.linhas.append([None if i is None else x[i] for i in pos])
        except (ValueError, TypeError):
            pass

    def anotar(self, a):
        r = resumo_amostra(a)
        m = int(r["t"] // 60 * 60)
        with self.trava:
            if self.minuto != m:
                self.fechar()
                self.minuto, self.acc = m, collections.defaultdict(list)
            for k in ("cpu", "tc", "gpu", "tg", "w", "vr", "ram", "sw", "ping", "nv", "pl", "jt", "rx", "tx", "fps"):
                if r[k] is not None and r[k] >= 0:
                    self.acc[k].append(r[k])
            if r["j"]:
                self.acc["j"] = [r["j"]]

    def fechar(self):
        x = self.acc
        if not x:
            return
        media = lambda k: round(sum(x[k]) / len(x[k]), 1) if x[k] else None
        mx = lambda k: max(x[k]) if x[k] else None
        self.linhas.append([self.minuto, media("cpu"), mx("cpu"), mx("tc"), media("gpu"), mx("gpu"), mx("tg"), mx("w"),
                            mx("vr"), min(x["ram"]) if x["ram"] else None, mx("sw"), media("ping"), mx("ping"),
                            (x["j"] or [None])[0], mx("nv") or 0, mx("pl"), media("jt"), media("rx"), media("tx"),
                            media("fps"), min(x["fps"]) if x["fps"] else None])
        self.acc = None
        self.mudou = True

    def dados(self):
        with self.trava:
            linhas = list(self.linhas)
        return {"cols": self.COLS, "linhas": linhas}

    def salvar(self):
        if not self.mudou:
            return
        self.mudou = False
        try:
            gravar_json(ARQ_H24, self.dados())
        except OSError as e:
            avisar("historico", e)


class Sessoes:
    # one summary per game session (at least 2 minutes), appended to sessoes.jsonl
    def __init__(self):
        self.atual = None

    def anotar(self, a, ft_lista=()):
        j = a["jogos"][0] if a["jogos"] else None
        if self.atual and (not j or j["nome"] != self.atual["nome"]):
            self.fechar()
        if not j:
            return
        s = self.atual
        if s is None:
            s = self.atual = {"nome": j["nome"], "ini": round(j["desde"]), "fim": round(a["t"]), "n": 0, "cpu": 0.0, "gpu": 0.0,
                              "tc_max": None, "tg_max": None, "w_max": None, "vram_max": None, "vram_jogo": 0,
                              "ram_min": None, "ram_jogo": 0, "swap_max": 0, "ping_max": None,
                              "ping_s": 0.0, "ping_n": 0, "perda_max": None, "jit_s": 0.0, "jit_n": 0,
                              "fps_s": 0.0, "fps_n": 0, "ft": [0] * (len(self.BINS) + 1)}
        g, c, r = a["gpu"], a["cpu"], a["ram"]
        mx = lambda k, v: s.update({k: v if s[k] is None or (v is not None and v > s[k]) else s[k]})
        s["fim"] = round(a["t"])
        s["n"] += 1
        s["cpu"] += c["uso"] or 0
        s["gpu"] += g.get("uso") or 0
        mx("tc_max", c["temp"])
        mx("tg_max", g.get("temp"))
        mx("w_max", g.get("watts"))
        mx("vram_max", g.get("vram"))
        mx("ping_max", a["rede"]["ping"] if (a["rede"]["ping"] or 0) >= 0 else None)
        rd = a["rede"]
        if rd["ping"] is not None and rd["ping"] >= 0:
            s["ping_s"] += rd["ping"]
            s["ping_n"] += 1
        if rd["n"] >= 10:
            mx("perda_max", rd["perda"])
        if rd["osc"] is not None:
            s["jit_s"] += rd["osc"]
            s["jit_n"] += 1
        left = r["left"] // 1024
        s["ram_min"] = left if s["ram_min"] is None else min(s["ram_min"], left)
        s["ram_jogo"] = max(s["ram_jogo"], j["kb"])
        s["vram_jogo"] = max(s["vram_jogo"], j["vram"] or 0)
        s["swap_max"] = max(s["swap_max"], r["swap"] // 1024)
        q = a.get("fps")
        if q:
            s["fps_s"] += q["fps"]
            s["fps_n"] += 1
        for v in ft_lista:
            s["ft"][bisect.bisect_left(self.BINS, v)] += 1

    # frame time histogram (ms): fine steps where games live, coarse above
    BINS = [x / 4 for x in range(1, 201)] + [50 + x for x in range(1, 151)] + [200 + 10 * x for x in range(1, 81)]

    def baixa_1(self, s):
        # "1 % low": the frame time 99 % of the sampled frames beat, as FPS
        tot = sum(s["ft"])
        if tot < 50:
            return None
        alvo, acc = tot * 0.99, 0
        for i, n in enumerate(s["ft"]):
            acc += n
            if acc >= alvo:
                return round(1000 / (self.BINS[min(i, len(self.BINS) - 1)]), 1)
        return None

    def resumo(self, s):
        if not s:
            return None
        x = {k: v for k, v in s.items() if k not in ("cpu", "gpu", "n", "ping_s", "ping_n", "jit_s", "jit_n", "fps_s", "fps_n", "ft")}
        x["fps"] = round(s["fps_s"] / s["fps_n"], 1) if s.get("fps_n") else None
        x["fps_low"] = self.baixa_1(s) if s.get("ft") else None
        x["ping"] = round(s["ping_s"] / s["ping_n"], 1) if s["ping_n"] else None
        x["jit"] = round(s["jit_s"] / s["jit_n"], 1) if s["jit_n"] else None
        x["cpu"] = round(s["cpu"] / s["n"]) if s["n"] else None
        x["gpu"] = round(s["gpu"] / s["n"]) if s["n"] else None
        x["alertas"] = sum(1 for e in list(eventos) if e.get("jogo") == s["nome"] and e["t"] >= s["ini"])
        return x

    def fechar(self):
        s, self.atual = self.atual, None
        if not s or s["fim"] - s["ini"] < 120:
            return
        try:
            os.makedirs(PASTA_DADOS, exist_ok=True)
            with open(ARQ_SESSOES, "a") as f:
                f.write(json.dumps(self.resumo(s), separators=(",", ":"), ensure_ascii=False) + "\n")
            if os.path.getsize(ARQ_SESSOES) > 512 * 1024:
                with open(ARQ_SESSOES) as f:
                    resto = f.readlines()[-1000:]
                with open(ARQ_SESSOES + ".novo", "w") as f:
                    f.writelines(resto)
                os.replace(ARQ_SESSOES + ".novo", ARQ_SESSOES)
        except OSError as e:
            avisar("sessoes", e)

    def lista(self, n=100):
        saida = []
        for linha in reversed(cauda(ARQ_SESSOES, 262144).decode(errors="replace").splitlines()):
            try:
                x = json.loads(linha)
            except ValueError:
                continue
            if isinstance(x, dict):
                saida.append(x)
            if len(saida) >= n:
                break
        return saida


caixa = CaixaPreta()
h24 = Historico24()
sessoes = Sessoes()
dica = {"t": 0.0, "txt": None}


def escrever_dica(a):
    # a few readings for the tray tooltip, at most every 30 s, only when it changed
    if not cfg["dica"]:
        apagar_dica()
        return
    if a["t"] - dica["t"] < 30:
        return
    dica["t"] = a["t"]
    pt = cfg["idioma"] == "pt"
    c, g, r = a["cpu"], a["gpu"], a["ram"]
    n0 = lambda v: "?" if v is None else "%d" % round(v)
    linhas = ["CPU %s %% · %s °C" % (n0(c["uso"]), n0(c["temp"]))]
    if g.get("ok"):
        linhas.append("GPU %s %% · %s °C · VRAM %.1f / %.0f GiB" % (n0(g["uso"]), n0(g["temp"]), g["vram"] / 1024, g["vram_total"] / 1024))
    linhas.append(("RAM livre %.1f GiB" if pt else "Free RAM %.1f GiB") % (r["left"] / 1048576))
    if a["rede"]["ping"] is not None and a["rede"]["ping"] >= 0:
        linhas.append("Ping %d ms" % round(a["rede"]["ping"]))
    if a["jogos"]:
        j = a["jogos"][0]
        linhas.append("%s · %s" % (j["nome"][:40], duracao(a["t"] - j["desde"])))
    txt = "\n".join(linhas) + "\n"
    if txt == dica["txt"]:
        return
    try:
        os.makedirs(os.path.dirname(ARQ_DICA), exist_ok=True)
        with open(ARQ_DICA + ".new", "w") as f:
            f.write(txt)
        os.replace(ARQ_DICA + ".new", ARQ_DICA)
        dica["txt"] = txt
    except OSError as e:
        avisar("dica", e)


def apagar_dica():
    if dica["txt"] is None and not os.path.exists(ARQ_DICA):
        return
    dica.update(t=0.0, txt=None)
    try:
        os.remove(ARQ_DICA)
    except OSError:
        pass


def duracao(seg):
    seg = int(max(0, seg))
    h, m = seg // 3600, seg // 60 % 60
    return "%d h %02d min" % (h, m) if h else "%d min" % m


# ---------------------------------------------------------------- SSD health (UDisks2, no root needed)

ssd = {}                            # block device name -> health
ssd_base = {}                       # drive -> error count already seen, so only new errors alert
ssd_ritmo = {}                      # drive -> [[time, bytes written, % used, power-on hours]], one every 6 h


def previsao_ssd(chave, h):
    # Life forecast of an NVMe SSD. The drive reports "% used" of its rated endurance and the
    # bytes written, so bytes per 1 % comes from the drive itself; the pace is what it wrote
    # over the last days (at least one). An estimate: % used is a whole number, so with a
    # few % only the forecast is rough, and 100 % is the rating, not the end of the drive.
    if h["escrito"] is None or h["gasto"] is None:
        return None, False
    agora, novo = time.time(), False
    pts = ssd_ritmo.setdefault(chave, [])
    if not pts or agora - pts[-1][0] >= 6 * 3600:
        pts.append([round(agora), h["escrito"], h["gasto"], h["horas"]])
        del pts[:-240]
        novo = True
    p = {"tb_pct": None, "restam_tb": None, "tb_dia": None, "dias": None, "anos": None, "aprox": h["gasto"] < 5}
    if h["gasto"] >= 1:
        por = h["escrito"] / h["gasto"]
        p.update(tb_pct=round(por / 1e12, 2), restam_tb=round(max(0, 100 - h["gasto"]) * por / 1e12, 1))
    base = next((x for x in pts if agora - x[0] <= 30 * 86400), None)
    if base and agora - base[0] >= 86400 and h["escrito"] >= base[1]:
        dias = (agora - base[0]) / 86400
        p.update(tb_dia=round((h["escrito"] - base[1]) / 1e12 / dias, 4), dias=round(dias, 1))
        if p["restam_tb"] is not None and p["tb_dia"] > 0:
            p["anos"] = round(p["restam_tb"] / p["tb_dia"] / 365, 1)
    return p, novo


def busctl_json(*args):
    saida = rodar(["busctl", "--system", "--auto-start=no", "--json=short", "call", "org.freedesktop.UDisks2"] + list(args), 10)
    try:
        return json.loads(saida)["data"] if saida else None
    except (ValueError, KeyError, TypeError):
        return None


def saude_ssd():
    d = busctl_json("/org/freedesktop/UDisks2", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects")
    if not d:
        return
    objs, U = d[0], "org.freedesktop.UDisks2."
    val = lambda ifs, i, k: (ifs.get(U + i, {}).get(k) or {}).get("data")
    blocos = {}
    for caminho, ifs in objs.items():
        drive = val(ifs, "Block", "Drive")
        if drive and drive != "/" and U + "Partition" not in ifs:
            dev = bytes(val(ifs, "Block", "Device") or []).rstrip(b"\0").decode(errors="replace")
            blocos[drive] = os.path.basename(dev)
    if not ssd_base:
        try:
            ssd_base.update(json.loads(ler(ARQ_SSD) or "{}"))
        except ValueError:
            pass
    if not ssd_ritmo:
        try:
            x = json.loads(ler(ARQ_SSD_RITMO) or "{}")
            ssd_ritmo.update({k: v for k, v in x.items() if isinstance(v, list)} if isinstance(x, dict) else {})
        except ValueError:
            pass
    novo, mudou, ritmo_mudou = {}, False, False
    for drive, dev in blocos.items():
        ifs = objs.get(drive, {})
        h = {"saude": None, "gasto": None, "reserva": None, "reserva_min": None, "escrito": None, "horas": None,
             "inseguros": None, "erros": 0, "problema": None, "previsao": None}
        if U + "NVMe.Controller" in ifs:
            at = busctl_json(drive, U + "NVMe.Controller", "SmartGetAttributes", "a{sv}", "0")
            at = {k: v.get("data") for k, v in at[0].items()} if at else {}
            if at.get("percent_used") is not None:
                h["gasto"] = at["percent_used"]
                h["saude"] = max(0, 100 - at["percent_used"])
            h.update(reserva=at.get("avail_spare"), reserva_min=at.get("spare_thresh"), escrito=at.get("total_data_written"),
                     inseguros=at.get("unsafe_shutdowns"), erros=at.get("media_errors") or 0,
                     horas=val(ifs, "NVMe.Controller", "SmartPowerOnHours"))
            h["previsao"], n = previsao_ssd(os.path.basename(drive), h)
            ritmo_mudou = ritmo_mudou or n
            avisos = val(ifs, "NVMe.Controller", "SmartCriticalWarning") or []
            if avisos:
                h["problema"] = ("o SSD avisa: " + ", ".join(avisos), "the SSD reports: " + ", ".join(avisos))
        elif val(ifs, "Drive.Ata", "SmartSupported") and val(ifs, "Drive.Ata", "SmartEnabled"):
            at = busctl_json(drive, U + "Drive.Ata", "SmartGetAttributes", "a{sv}", "0")
            por_id = {x[0]: x for x in (at[0] if at else [])}
            seg = val(ifs, "Drive.Ata", "SmartPowerOnSeconds")
            h["horas"] = seg // 3600 if seg else None
            if 170 in por_id:               # available reserved space, normalized
                h["reserva"], h["reserva_min"] = por_id[170][3], por_id[170][5]
            # reallocated + pending sectors (libatasmart) and errors the drive could not correct
            h["erros"] = (val(ifs, "Drive.Ata", "SmartNumBadSectors") or 0) + (por_id[187][6] if 187 in por_id else 0)
            if val(ifs, "Drive.Ata", "SmartFailing"):
                h["problema"] = ("o SMART diz que o disco está falhando", "SMART says the disk is failing")
            elif (val(ifs, "Drive.Ata", "SmartNumAttributesFailing") or 0) > 0:
                h["problema"] = ("atributos do SMART abaixo do limite", "SMART attributes below threshold")
        else:
            continue
        if h["reserva"] is not None and h["reserva_min"] and h["reserva"] <= h["reserva_min"] and not h["problema"]:
            h["problema"] = ("reserva do SSD esgotada (%d %%)" % h["reserva"], "SSD spare area used up (%d %%)" % h["reserva"])
        chave = os.path.basename(drive)
        antes = ssd_base.get(chave)
        if antes is None or h["erros"] > antes:
            k = cfg["limites"]["ssd_saude"]
            if h["erros"] > (antes or 0) and k["on"]:
                nome = next((x["nome"] for x in discos if x["dev"] == dev), dev)
                nome_pt, nome_en = ("Sistema", "System") if nome == "/" else (nome, nome)
                evento_avulso(k["nv"], "SSD %s registrou %d erro(s) de leitura/gravação (total %d)" % (nome_pt, h["erros"] - (antes or 0), h["erros"]),
                              "SSD %s logged %d new read/write error(s) (total %d)" % (nome_en, h["erros"] - (antes or 0), h["erros"]), "disc")
            ssd_base[chave] = h["erros"]
            mudou = True
        novo[dev] = h
    ssd.clear()
    ssd.update(novo)
    try:
        if mudou:
            gravar_json(ARQ_SSD, ssd_base)
        if ritmo_mudou:
            gravar_json(ARQ_SSD_RITMO, ssd_ritmo)
    except OSError as e:
        avisar("ssd", e)


# ---------------------------------------------------------------- fans (the part without root)

def pontos_validos(p, minimo):
    # 4 points [degrees, %]: degrees always rising (20 to 90), % never falling
    if not isinstance(p, list) or len(p) != 4:
        return None
    saida = []
    for x in p:
        if not (isinstance(x, list) and len(x) == 2 and numero(x[0]) and numero(x[1])):
            return None
        saida.append([int(min(90, max(20, x[0]))), int(min(100, max(minimo, x[1])))])
    for a, b in zip(saida, saida[1:]):
        if b[0] <= a[0] or b[1] < a[1]:
            return None
    return saida


def limpar_fans(d, canais):
    # the user's choice: graphics card + one entry per motherboard fan
    nova = {"gpu": {"modo": "max", "pct": 100, "pontos": copia(CURVA_GPU)},
            "placa": {c: {"modo": "max", "pct": 100, "pontos": copia(CURVAS["equilibrada"])} for c in canais}}
    if not isinstance(d, dict):
        return nova
    g = d.get("gpu")
    if isinstance(g, dict):
        if g.get("modo") in ("max", "auto", "fixo", "curva"):
            nova["gpu"]["modo"] = g["modo"]
        if numero(g.get("pct")):
            nova["gpu"]["pct"] = int(min(100, max(30, g["pct"])))
        nova["gpu"]["pontos"] = pontos_validos(g.get("pontos"), 30) or nova["gpu"]["pontos"]
    p = d.get("placa")
    if isinstance(p, dict) and "modo" in p:     # old format: one choice for all fans
        p = {c: dict(p, pontos=CURVAS.get(p.get("curva"))) for c in canais}
    if isinstance(p, dict):
        for c in canais:
            x = p.get(c)
            if not isinstance(x, dict):
                continue
            if x.get("modo") in ("max", "fixo", "curva"):
                nova["placa"][c]["modo"] = x["modo"]
            if numero(x.get("pct")):
                nova["placa"][c]["pct"] = int(min(100, max(20, x["pct"])))
            nova["placa"][c]["pontos"] = pontos_validos(x.get("pontos"), 20) or nova["placa"][c]["pontos"]
    return nova


def interpolar(pontos, temp):
    if temp <= pontos[0][0]:
        return pontos[0][1]
    for (t0, p0), (t1, p1) in zip(pontos, pontos[1:]):
        if temp <= t1:
            return p0 + (p1 - p0) * (temp - t0) / (t1 - t0)
    return pontos[-1][1]


def alvo_da_curva(temp):
    if temp is None or temp >= 86:
        return 100
    return int(max(30, min(100, round(interpolar(cfg["fans"]["gpu"]["pontos"], temp)))))


def gravar_comando(alvo_gpu=None, placa=None, so_se_mudou=False):
    # the root helper (pc-panel-fans.path) sees the file change and applies it
    f = cfg["fans"]
    cmd = {"v": 2, "gpu": {"modo": f["gpu"]["modo"], "pct": f["gpu"]["pct"]}, "placa": placa or f["placa"]}
    if f["gpu"]["modo"] == "curva":
        cmd["gpu"]["alvo"] = alvo_gpu or 100
    if so_se_mudou:
        try:
            if json.loads(ler(ARQ_FANS) or "null") == cmd:
                return
        except ValueError:
            pass
    with open(ARQ_FANS, "w") as arq:
        json.dump(cmd, arq)


def ler_fans():
    pode = any(os.path.exists(a) for a in AJUDANTES_FANS) and os.access(ARQ_FANS, os.W_OK)
    aplicado = None
    if pode:
        try:
            aplicado = json.loads(ler(ARQ_FANS_ESTADO) or "null")
        except ValueError:
            aplicado = None
    # the old helper answered with a single choice for the motherboard
    velho = isinstance(aplicado, dict) and "modo" in (aplicado.get("placa") or {})
    fans.update(pode=pode, aplicado=aplicado, velho=velho)


def canais_fans():
    # motherboard fans that spin; once seen, a fan stays in the list
    achados = list(cfg["canais"])
    for arq in fontes["fans"]:
        n = re.search(r"fan(\d)_input", arq).group(1)
        if n not in achados and (ler_int(arq) or 0) > 0:
            achados.append(n)
    return sorted(achados)


def preparar_fans():
    # builds the choice the first time (from what was already applied)
    canais = canais_fans()
    escolha = cfg["fans"]
    if escolha is None:
        try:
            escolha = json.loads(ler(ARQ_FANS) or "null")
        except ValueError:
            escolha = None
    nova = limpar_fans(escolha, canais)
    if nova != cfg["fans"] or canais != cfg["canais"]:
        c = copia(cfg)
        c.update(fans=nova, canais=canais)
        try:
            salvar_cfg(c)
        except OSError as e:
            avisar("config", e)
            cfg.update(fans=nova, canais=canais)


def guiar_gpu(temp):
    # custom graphics card curve: NVIDIA cards do not store a curve, so the
    # target is recomputed here and sent only when it really changes
    f = cfg["fans"]
    if not fans["pode"] or not f or f["gpu"]["modo"] != "curva" or temp is None or fans["calibrando"] is not None:
        return
    alvo = alvo_da_curva(temp)
    antes, agora = curva_gpu["alvo"], time.monotonic()
    if antes is not None:
        sobe, desce = alvo - antes, antes - alvo
        if sobe < 3 and desce < 5:
            return
        if agora - curva_gpu["quando"] < (2 if sobe >= 10 else 6):
            return
    try:
        gravar_comando(alvo)
        curva_gpu.update(alvo=alvo, quando=agora)
    except OSError as e:
        avisar("fans", e)


quente = {"gpu": 0, "placa": 0}


def proteger_fans(tgpu, tcpu):
    # a fixed fan does not speed up by itself: if it gets too hot, go back to 100 %
    f = cfg["fans"]
    if not fans["pode"] or not f or fans["calibrando"] is not None:
        return
    nova = None
    if f["gpu"]["modo"] == "fixo" and tgpu is not None and tgpu >= 86:
        quente["gpu"] += 1
        if quente["gpu"] >= 3:
            nova = copia(f)
            nova["gpu"]["modo"] = "max"
            evento_avulso("serio", "Proteção colocou as fans da placa de vídeo em 100 %% (%d °C)" % tgpu,
                          "Protection set the graphics card fans to 100 %% (%d °C)" % tgpu, "temp")
    else:
        quente["gpu"] = 0
    if any(x["modo"] == "fixo" for x in f["placa"].values()) and tcpu is not None and tcpu >= 93:
        quente["placa"] += 1
        if quente["placa"] >= 3:
            nova = nova or copia(f)
            for x in nova["placa"].values():
                if x["modo"] == "fixo":
                    x["modo"] = "max"
            evento_avulso("serio", "Proteção colocou as fans do processador em 100 %% (%d °C)" % tcpu,
                          "Protection set the processor fans to 100 %% (%d °C)" % tcpu, "temp")
    else:
        quente["placa"] = 0
    if nova:
        quente.update(gpu=0, placa=0)
        c = copia(cfg)
        c["fans"] = nova
        try:
            salvar_cfg(c)
            gravar_comando(curva_gpu["alvo"])
        except OSError as e:
            avisar("fans", e)


def calibrar():
    # measures how many rpm each motherboard fan makes at each percentage (42 s)
    canais = list(cfg["fans"]["placa"])
    if not canais or fans["calibrando"] is not None:
        return
    fans["calibrando"] = 0
    tabela = {c: [] for c in canais}
    try:
        for i, pct in enumerate((100, 85, 70, 55, 40, 30, 20)):
            if ((estado.get("cpu") or {}).get("temp") or 0) >= 90:
                break               # too hot to slow the fan down
            gravar_comando(curva_gpu["alvo"], {c: {"modo": "fixo", "pct": pct, "pontos": CURVAS["equilibrada"]}
                                               for c in canais})
            time.sleep(6)
            for c in canais:
                tabela[c].append([pct, ler_int("%s/fan%s_input" % (fontes["chip"], c)) or 0])
            fans["calibrando"] = i + 1
        if all(len(v) >= 3 for v in tabela.values()):
            c = copia(cfg)
            c["calib"] = tabela
            salvar_cfg(c)
    except OSError as e:
        avisar("calibrar", e)
    finally:
        try:
            gravar_comando(curva_gpu["alvo"])       # back to the user's choice
        except OSError:
            pass
        fans["calibrando"] = None


def ao_parar():
    # with the panel stopped nobody drives the graphics card curve: hand it back to
    # the factory curve. The choice stays saved and returns when the panel starts.
    # The tray icon goes back to normal, and the black box notes a clean stop.
    caixa_ok()
    for arq in (ARQ_ALERTA, ARQ_DICA):
        try:
            os.remove(arq)
        except OSError:
            pass
    try:
        cmd = json.loads(ler(ARQ_FANS) or "null")
        if isinstance(cmd, dict) and isinstance(cmd.get("gpu"), dict) and cmd["gpu"].get("modo") == "curva":
            cmd["gpu"] = {"modo": "auto", "pct": 100}
            with open(ARQ_FANS, "w") as arq:
                json.dump(cmd, arq)
    except (OSError, ValueError):
        pass


# ---------------------------------------------------------------- graphics card (NVML)

class _Uso(ctypes.Structure):
    _fields_ = [("gpu", ctypes.c_uint), ("mem", ctypes.c_uint)]


class _Mem(ctypes.Structure):
    _fields_ = [("total", ctypes.c_ulonglong), ("livre", ctypes.c_ulonglong), ("usada", ctypes.c_ulonglong)]


class _Proc(ctypes.Structure):
    _fields_ = [("pid", ctypes.c_uint), ("mem", ctypes.c_ulonglong),
                ("gi", ctypes.c_uint), ("ci", ctypes.c_uint)]


class _Rpm(ctypes.Structure):
    _fields_ = [("versao", ctypes.c_uint), ("fan", ctypes.c_uint), ("rpm", ctypes.c_uint)]


class Nvidia:
    # Reads the card through the NVIDIA library, without spawning a process (nvidia-smi)
    # per sample and without creating a graphics context (uses no VRAM).
    def __init__(self):
        self.lib = self.h = None
        self.fixo = {}
        self.nfans = 0
        self.tentar_em = 0.0
        self.ausente = False        # this PC does not have the NVIDIA library
        self.erro = ("ainda não li a placa", "card not read yet")

    def abrir(self):
        self.tentar_em = time.monotonic() + 30
        try:
            try:
                lib = ctypes.CDLL("libnvidia-ml.so.1")
            except OSError:
                self.ausente = True
                raise
            r = lib.nvmlInit_v2()
            if r == 9:              # NVML_ERROR_DRIVER_NOT_LOADED: library installed, no card
                self.ausente = True
            if r == 18:
                raise Falha("o driver foi atualizado e falta reiniciar o PC", "the driver was updated, reboot needed")
            if r:
                raise Falha("a biblioteca da NVIDIA devolveu o erro %d" % r, "the NVIDIA library returned error %d" % r)
            h = ctypes.c_void_p()
            if lib.nvmlDeviceGetHandleByIndex_v2(0, ctypes.byref(h)):
                lib.nvmlShutdown()
                raise Falha("placa NVIDIA não encontrada", "NVIDIA card not found")
            nome, drv = ctypes.create_string_buffer(96), ctypes.create_string_buffer(80)
            lim, nf = ctypes.c_uint(), ctypes.c_uint()
            lib.nvmlDeviceGetName(h, nome, 96)
            lib.nvmlSystemGetDriverVersion(drv, 80)
            lib.nvmlDeviceGetPowerManagementLimit(h, ctypes.byref(lim))
            lib.nvmlDeviceGetNumFans(h, ctypes.byref(nf))
            self.nfans = min(nf.value, 4)
            lt = {}
            for nome_t, tipo in (("desligar", 0), ("lento", 1), ("max", 3)):
                v = ctypes.c_uint()
                if lib.nvmlDeviceGetTemperatureThreshold(h, tipo, ctypes.byref(v)) == 0 and 40 <= v.value <= 130:
                    lt[nome_t] = v.value
            hw_lim["gpu"] = lt
            rec_cache["v"] = None
            self.fixo = {"nome": nome.value.decode(errors="replace").replace("NVIDIA GeForce ", ""),
                         "driver": drv.value.decode(errors="replace"), "watts_max": round(lim.value / 1000)}
            self.lib, self.h, self.erro = lib, h, None
        except Falha as e:
            self.lib, self.erro = None, e.args
        except (OSError, AttributeError) as e:
            self.lib, self.erro = None, (str(e), str(e))

    def medir(self):
        if self.lib is None and time.monotonic() >= self.tentar_em:
            self.abrir()
        if self.lib is None:
            return {"ok": False, "erro": self.erro}, {}
        lib, h, ref = self.lib, self.h, ctypes.byref
        uso, mem = _Uso(), _Mem()
        temp, mw, fan, mhz, enc, periodo = (ctypes.c_uint() for _ in range(6))
        if lib.nvmlDeviceGetUtilizationRates(h, ref(uso)) or lib.nvmlDeviceGetMemoryInfo(h, ref(mem)):
            lib.nvmlShutdown()
            self.lib, self.erro = None, ("a placa parou de responder", "the card stopped answering")
            self.tentar_em = time.monotonic() + 30
            return {"ok": False, "erro": self.erro}, {}
        lib.nvmlDeviceGetTemperature(h, 0, ref(temp))
        lib.nvmlDeviceGetPowerUsage(h, ref(mw))
        lib.nvmlDeviceGetFanSpeed(h, ref(fan))
        lib.nvmlDeviceGetClockInfo(h, 0, ref(mhz))
        lib.nvmlDeviceGetEncoderUtilization(h, ref(enc), ref(periodo))
        rpm = []
        for i in range(self.nfans):
            r = _Rpm(ctypes.sizeof(_Rpm) | (1 << 24), i, 0)
            try:
                if lib.nvmlDeviceGetFanSpeedRPM(h, ref(r)) == 0:
                    rpm.append(r.rpm)
            except AttributeError:
                break
        procs = {}
        for funcao in ("nvmlDeviceGetGraphicsRunningProcesses_v3", "nvmlDeviceGetComputeRunningProcesses_v3"):
            n, lista = ctypes.c_uint(128), (_Proc * 128)()
            try:
                if getattr(lib, funcao)(h, ref(n), lista) == 0:
                    for p in lista[:n.value]:
                        if p.mem < 1 << 60:
                            procs[p.pid] = max(procs.get(p.pid, 0), p.mem >> 20)
            except AttributeError:
                pass
        # "used" = total minus free: includes the ~300 MiB the driver reserves,
        # same as MangoHud (nvidia-smi shows it without that reserve)
        info = dict(self.fixo, ok=True, uso=uso.gpu, vram=(mem.total - mem.livre) >> 20,
                    vram_total=mem.total >> 20, temp=temp.value, watts=round(mw.value / 1000),
                    fan=fan.value, rpm=rpm, mhz=mhz.value, enc=enc.value)
        return info, procs


class Amd:
    # AMD card (and integrated graphics) through the amdgpu sysfs. No per-program VRAM.
    def __init__(self):
        self.dev = self.hw = None
        melhor = -1
        for d in glob.glob("/sys/class/drm/card[0-9]*/device"):
            total = ler_int(d + "/mem_info_vram_total")
            if (ler(d + "/vendor") or "").strip() == "0x1002" and total is not None and total > melhor:
                melhor, self.dev = total, d
        if self.dev:
            self.hw = (glob.glob(self.dev + "/hwmon/hwmon*") or [None])[0]
            c = limite_do_sensor(self.hw + "/temp1_input")[1] if self.hw else None
            if c and not hw_lim["gpu"]:
                hw_lim["gpu"] = {"crit": round(c)}
                rec_cache["v"] = None

    def medir(self):
        d, h = self.dev, self.hw
        total, usada = ler_int(d + "/mem_info_vram_total") or 0, ler_int(d + "/mem_info_vram_used") or 0
        if not total:
            return {"ok": False, "ausente": True, "erro": ("placa sem leitura", "card not readable")}, {}
        temp = ler_int(h + "/temp1_input") if h else None
        watts = (ler_int(h + "/power1_average") or ler_int(h + "/power1_input")) if h else None
        pwm, rpm = (ler_int(h + "/pwm1"), ler_int(h + "/fan1_input")) if h else (None, None)
        mhz = ler_int(h + "/freq1_input") if h else None
        return {"ok": True, "nome": "AMD Radeon", "driver": None, "watts_max": None,
                "uso": ler_int(d + "/gpu_busy_percent") or 0, "vram": usada >> 20, "vram_total": max(1, total >> 20),
                "temp": round(temp / 1000) if temp else None, "watts": round(watts / 1e6) if watts else None,
                "fan": None if pwm is None else round(pwm / 2.55), "rpm": [rpm] if rpm else [],
                "mhz": round(mhz / 1e6) if mhz else None, "enc": None}, {}


# ---------------------------------------------------------------- sensors, route and disks (slow)

def achar_fontes():
    f = {"cpu": None, "placa": None, "chip": None, "mem": [], "fans": [], "nvme": {}}
    for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        nome = (ler(d + "/name") or "").strip()
        if nome in ("k10temp", "zenpower", "coretemp"):
            f["cpu"] = d + "/temp1_input"
        elif nome.startswith("nct67"):
            f["placa"], f["chip"] = d + "/temp1_input", d
            f["fans"] = sorted(glob.glob(d + "/fan[0-9]_input"))
        elif nome == "spd5118":
            f["mem"].append(d + "/temp1_input")
        elif nome == "nvme":
            f["nvme"][os.path.realpath(d + "/device")] = d + "/temp1_input"
    fontes.update(f)


def achar_rota():
    # interface and router of the default route (lowest metric)
    melhor = None
    for linha in (ler("/proc/net/route") or "").splitlines()[1:]:
        p = linha.split()
        if len(p) > 7 and p[1] == "00000000" and int(p[3], 16) & 2:
            if melhor is None or int(p[6]) < melhor[0]:
                melhor = (int(p[6]), p[0], socket.inet_ntoa(struct.pack("<L", int(p[2], 16))))
    if not melhor:
        rota.update(iface=None, gw=None, ip=None, link=None, erros=None, descartes=None, mtu=None, duplex=None, wifi=False)
        return
    ip = None
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect((melhor[2], 9))       # sends nothing, only finds the local IP
        ip = s.getsockname()[0]
        s.close()
    except OSError:
        pass
    base = "/sys/class/net/%s/" % melhor[1]

    def soma(*nomes):
        return sum(ler_int(base + "statistics/" + n) or 0 for n in nomes)

    link = ler_int(base + "speed")
    rota.update(iface=melhor[1], gw=melhor[2], ip=ip, link=link if link and link > 0 else None,
                erros=soma("rx_errors", "tx_errors"), descartes=soma("rx_dropped", "tx_dropped"),
                mtu=ler_int(base + "mtu"), duplex=(ler(base + "duplex") or "").strip() or None,
                wifi=os.path.isdir(base + "wireless"))


def achar_discos():
    achados, vistos = [], set()
    for linha in (ler("/proc/mounts") or "").splitlines():
        p = linha.split()
        if len(p) < 3 or not p[0].startswith("/dev/"):
            continue
        if p[2] not in ("ext4", "btrfs", "xfs", "f2fs", "ntfs", "ntfs3", "exfat"):
            continue
        ponto = p[1].replace("\\040", " ")
        bloco = os.path.realpath("/sys/class/block/" + os.path.basename(os.path.realpath(p[0])))
        if not os.path.isdir(bloco):
            continue
        if os.path.exists(bloco + "/partition"):
            bloco = os.path.dirname(bloco)
        dev = os.path.basename(bloco)
        if dev in vistos:
            continue
        vistos.add(dev)
        d = {"nome": "/" if ponto == "/" else os.path.basename(ponto),
             "modelo": " ".join((ler(bloco + "/device/model") or "").split()),
             "ponto": ponto, "dev": dev, "total": 0, "livre": 0,
             "temp_arq": fontes["nvme"].get(os.path.realpath(bloco + "/device"))}
        try:
            s = os.statvfs(ponto)
            d["total"], d["livre"] = s.f_blocks * s.f_frsize, s.f_bavail * s.f_frsize
        except OSError:
            pass
        achados.append(d)
    discos[:] = achados


def info_sistema():
    falhas = []
    for args in (["systemctl", "--failed", "--no-legend", "--plain"],
                 ["systemctl", "--user", "--failed", "--no-legend", "--plain"]):
        for linha in (rodar(args, 8) or "").splitlines():
            unidade = linha.split()[0] if linha.split() else ""
            # app-*.service are programs started from the menu that exited with an error
            if unidade and not unidade.startswith("app-"):
                falhas.append(unidade)
    bateria = None
    for d in glob.glob("/sys/class/power_supply/*"):
        pct, st = ler_int(d + "/capacity"), (ler(d + "/status") or "").strip()
        if pct is not None and st in ("Discharging", "Charging", "Full"):
            modelo = (ler(d + "/model_name") or os.path.basename(d)).strip()
            fone = any(x in modelo.upper() for x in ("VOID", "HEADSET"))
            bateria = {"nome": "Headset" if fone else modelo, "pct": pct, "carregando": st == "Charging"}
            break
    return {"kernel": os.uname().release, "falhas": falhas, "bateria": bateria}


def cauda(arq, bytes_):
    try:
        with open(arq, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - bytes_))
            return f.read()
    except OSError:
        return b""


def info_saude():
    # kernel errors since boot, programs that crashed today, pending reboot
    # and when the last full system upgrade happened
    s, antes = dict(extra["saude"]), extra["saude"]
    saida = rodar(["journalctl", "-k", "-b", "-p", "3", "-q", "--no-pager", "-o", "cat"])
    if saida is not None:
        linhas = [x.strip() for x in saida.splitlines() if x.strip()]
        s["kerr"], s["kult"] = len(linhas), (linhas[-1][:220] if linhas else "")
        k = cfg["limites"]["kernel"]
        if antes["kerr"] is not None and s["kerr"] > antes["kerr"] and k["on"]:
            evento_avulso(k["nv"], "Erro novo do kernel: " + s["kult"], "New kernel error: " + s["kult"])
    saida = rodar(["coredumpctl", "list", "--since", "today", "--no-legend", "-q", "--no-pager"])
    if saida is not None:
        nomes = [os.path.basename(p) for linha in saida.splitlines() for p in linha.split() if p.startswith("/")]
        s["trav"], s["tult"] = len(nomes), (nomes[-1] if nomes else "")
        k = cfg["limites"]["travou"]
        if antes["trav"] is not None and s["trav"] > antes["trav"] and k["on"]:
            evento_avulso(k["nv"], "%s travou e foi fechado pelo sistema" % s["tult"], "%s crashed" % s["tult"])
    s["reinicio"] = not os.path.exists("/usr/lib/modules/%s/pkgbase" % os.uname().release)
    achados = re.findall(r"^\[([0-9T:+-]+)\] \[PACMAN\] starting full system upgrade",
                         cauda("/var/log/pacman.log", 262144).decode(errors="replace"), re.M)
    if achados:
        try:
            s["atualizado"] = time.mktime(time.strptime(achados[-1][:19], "%Y-%m-%dT%H:%M:%S"))
        except ValueError:
            pass
    extra["saude"] = s


def verificar_atualizacoes():
    # Downloads the package list to a temporary folder and compares. Never touches
    # the real pacman database and installs nothing.
    if upd["rodando"]:
        return
    upd["rodando"] = True
    tmp = tempfile.mkdtemp(prefix="pc-panel-db-")
    try:
        erro, pacotes, flat, fora = None, [], None, []
        if not shutil.which("pacman") and shutil.which("dnf"):
            # Fedora: dnf checks with the user's own cache, no root and no install
            r = subprocess.run(["nice", "-n", "19", "dnf", "check-update", "-q"], capture_output=True, text=True, timeout=300)
            if r.returncode not in (0, 100):
                erro = ("o dnf não conseguiu consultar", "dnf could not check")
            pacotes = [" ".join(x.split()[:2]) for x in r.stdout.splitlines() if len(x.split()) == 3][:400]
        elif not shutil.which("pacman"):
            erro = ("este sistema não usa pacman nem dnf", "this system uses neither pacman nor dnf")
        elif not shutil.which("fakeroot"):
            erro = ("falta o programa fakeroot", "the fakeroot program is missing")
        else:
            # packages from outside the official repositories (AUR, built by hand): pacman cannot check them
            fora = (rodar(["pacman", "-Qmq"], 30) or "").split()[:200]
            os.symlink("/var/lib/pacman/local", tmp + "/local")
            r = subprocess.run(["nice", "-n", "19", "fakeroot", "--", "pacman", "-Sy", "--disable-sandbox",
                                "--dbpath", tmp, "--logfile", "/dev/null"],
                               capture_output=True, text=True, timeout=180)
            if r.returncode:
                erro = ("não consegui baixar a lista de pacotes", "could not download the package list")
            else:
                saida = rodar(["pacman", "-Qu", "--dbpath", tmp], 60) or ""
                pacotes = [x.split()[0] + " " + x.split()[-1] for x in saida.splitlines() if "->" in x][:400]
        if shutil.which("flatpak"):
            saida = rodar(["flatpak", "remote-ls", "--updates", "--system", "--columns=application"], 90)
            flat = None if saida is None else len([x for x in saida.splitlines() if x.strip()])
        upd.update(quando=time.time(), pacotes=pacotes, flatpak=flat, fora=fora, erro=erro)
        os.makedirs(PASTA_CFG, exist_ok=True)
        with open(ARQ_UPD, "w") as f:
            json.dump({k: upd[k] for k in ("quando", "pacotes", "flatpak", "fora", "erro")}, f)
    except (OSError, subprocess.SubprocessError) as e:
        upd.update(quando=time.time(), erro=(str(e), str(e)))
    finally:
        try:
            if os.path.islink(tmp + "/local"):
                os.unlink(tmp + "/local")
            shutil.rmtree(tmp, ignore_errors=True)
        finally:
            upd["rodando"] = False


def metodo_instalacao():
    # how this program was installed decides who updates it: itself or the package manager
    if os.environ.get("APPIMAGE"):
        return "appimage"
    return "usuario" if os.path.realpath(__file__).startswith(os.path.expanduser("~") + os.sep) else "pacote"


def baixar(url, limite=96 << 20):
    pedido = urllib.request.Request(url, headers={"User-Agent": "pc-panel/" + VERSAO})
    with urllib.request.urlopen(pedido, timeout=40) as r:
        return r.read(limite)


def versao_tupla(v):
    return tuple(int(x) for x in re.findall(r"\d+", v)[:3])


def procurar_versao():
    # runs only when the user clicks: one request to GitHub, nothing but the version number travels
    if novidade["rodando"]:
        return
    novidade["rodando"] = True
    try:
        d = json.loads(baixar(os.environ.get("PC_PANEL_RELEASES_API") or "https://api.github.com/repos/%s/releases/latest" % REPO))
        tag = str(d["tag_name"])
        novidade.update(quando=time.time(), versao=tag.lstrip("v"), erro=None, nova=versao_tupla(tag) > versao_tupla(VERSAO),
                        arquivos={a["name"]: a["browser_download_url"] for a in d.get("assets", [])})
    except (OSError, ValueError, KeyError) as e:
        novidade.update(quando=time.time(), erro=("não achei versões publicadas (%s)" % e, "no published release found (%s)" % e))
    finally:
        novidade["rodando"] = False


def gerenciador():
    for nome in ("pacman", "dnf", "zypper"):
        if shutil.which(nome):
            return nome
    return None


def fora_do_servico(args):
    # runs args in its own transient user unit, so restarting this service cannot kill it halfway
    subprocess.Popen(["systemd-run", "--user", "--collect", "--quiet", "--unit", "pc-panel-update-%d" % time.time()] + args,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def atualizar_painel():
    # Downloads the new version, checks the published SHA-256 and installs it the same
    # way this copy was installed. Returns (None, needs_password) on success or
    # ((error in Portuguese, error in English), False).
    metodo, versao, arquivos = metodo_instalacao(), novidade["versao"], novidade["arquivos"]
    if not novidade["nova"]:
        return ("não há versão nova", "there is no new version"), False
    maquina = os.uname().machine
    gm = gerenciador()
    if metodo == "appimage":
        nome = "pc-panel-%s-x86_64.AppImage" % versao
    elif metodo == "pacote" and gm == "pacman":
        nome = "pc-panel-%s-1-%s.pkg.tar.zst" % (versao, maquina)
    elif metodo == "pacote" and gm in ("dnf", "zypper"):
        nome = "pc-panel-%s-1.%s.rpm" % (versao, maquina)
    elif metodo == "pacote":
        return ("não sei atualizar o pacote deste sistema", "unknown package manager on this system"), False
    else:
        nome = "pc-panel-%s-%s.tar.gz" % (versao, maquina)
        if nome not in arquivos:
            nome = "pc-panel-%s.tar.gz" % versao      # source only: the installer compiles the tray icon
    if nome not in arquivos or "SHA256SUMS" not in arquivos:
        return ("a versão publicada não tem o arquivo " + nome, "the release lacks the file " + nome), False
    try:
        somas = dict(reversed(x.split()) for x in baixar(arquivos["SHA256SUMS"], 1 << 20).decode().splitlines() if len(x.split()) == 2)
        dados = baixar(arquivos[nome])
        if hashlib.sha256(dados).hexdigest() != somas.get(nome, somas.get("*" + nome)):
            return ("o arquivo baixado não bate com o SHA-256 publicado", "the download does not match the published SHA-256"), False
        cache = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "pc-panel")
        os.makedirs(cache, exist_ok=True)
        if metodo == "appimage":
            alvo = os.environ["APPIMAGE"]
            with open(alvo + ".novo", "wb") as f:
                f.write(dados)
            os.chmod(alvo + ".novo", 0o755)
            os.replace(alvo + ".novo", alvo)

            def trocar():
                ao_parar()
                os._exit(75)            # the tray icon sees 75 and starts the new AppImage
            threading.Timer(1.5, trocar).start()
            return None, False
        if metodo == "pacote":
            for velho in glob.glob(cache + "/pc-panel-*.rpm") + glob.glob(cache + "/pc-panel-*.pkg.tar.zst"):
                os.remove(velho)
            arq = os.path.join(cache, nome)
            with open(arq, "wb") as f:
                f.write(dados)
            cmd = {"pacman": ["pacman", "-U", "--noconfirm", arq], "dnf": ["dnf", "install", "-y", arq],
                   "zypper": ["zypper", "--non-interactive", "install", "--allow-unsigned-rpm", arq]}[gm]
            fora_do_servico(["pkexec"] + cmd)       # the tray icon restarts the dashboard when the files change
            return None, True
        pasta = os.path.join(cache, "update")
        shutil.rmtree(pasta, ignore_errors=True)
        os.makedirs(pasta)
        with open(pasta + "/pacote.tar.gz", "wb") as f:
            f.write(dados)
        with tarfile.open(pasta + "/pacote.tar.gz") as t:
            t.extractall(pasta + "/x", filter="data")
        script = glob.glob(pasta + "/x/*/install.sh")
        if not script:
            return ("pacote com formato inesperado", "unexpected package layout"), False
        fora_do_servico(["sh", script[0], "--update"])
        return None, False
    except (OSError, ValueError, tarfile.TarError) as e:
        return ("não consegui atualizar (%s)" % e, "could not update (%s)" % e), False


def todos_sensores():
    def natural(x):
        return [int(y) if y.isdigit() else y for y in re.split(r"(\d+)", x)]

    grupos = []
    for d in sorted(glob.glob("/sys/class/hwmon/hwmon*"), key=natural):
        itens = []
        for arq in sorted(glob.glob(d + "/*_input"), key=natural):
            base, v = os.path.basename(arq)[:-6], ler_int(arq)
            if v is None:
                continue
            tipo = re.match(r"[a-z]+", base).group(0)
            txt = {"temp": "%.1f °C" % (v / 1000), "fan": "%d rpm" % v, "in": "%.3f V" % (v / 1000),
                   "power": "%.1f W" % (v / 1e6), "curr": "%.2f A" % (v / 1000)}.get(tipo, str(v))
            itens.append({"nome": (ler("%s/%s_label" % (d, base)) or base).strip(), "v": txt})
        if itens:
            grupos.append({"chip": (ler(d + "/name") or "?").strip(), "itens": itens})
    return grupos


# ---------------------------------------------------------------- processes, game, Zomboid server

RE_STATUS = re.compile(rb"RssAnon:\s+(\d+) kB\nRssFile:\s+\d+ kB\nRssShmem:\s+(\d+) kB\n"
                       rb"(?:[^\n]*\n){0,8}?VmSwap:\s+(\d+)")
RE_PONG = re.compile(rb"\[(\d\d)-(\d\d)-(\d\d) (\d\d):(\d\d):(\d\d)\.(\d\d\d)\][^\n]*? f:(\d+) [^\n]*ping@pong")
RE_CONEXAO = re.compile(rb'event="([^"]*)" message="([^"]*)" guid="(\d+)"(?:[^\n]*? username="([^"]*)")?')
nomes_app = {}
cache_pz = {"pid": None, "quando": 0.0, "dados": None, "con": (None, None)}
ant_cpu = {"t": 0.0, "ticks": {}}


def varrer_processos():
    procs = {}
    for nome in os.listdir("/proc"):
        if not nome.isdigit():
            continue
        try:
            with open("/proc/" + nome + "/stat", "rb") as f:
                s = f.read()
            a, b = s.index(b"("), s.rindex(b")")
            campos = s[b + 2:].split()
            p = {"comm": s[a + 1:b].decode(errors="replace"), "ppid": int(campos[1]),
                 "ticks": int(campos[11]) + int(campos[12]), "inicio": int(campos[19]), "kb": 0, "swap": 0}
            if int(campos[21]) * PAGINA_KB >= 8192:
                # real RAM of the program: anonymous + shared (the Java heap of
                # Zomboid shows up as shared memory)
                with open("/proc/" + nome + "/status", "rb") as f:
                    m = RE_STATUS.search(f.read())
                if m:
                    p["kb"], p["swap"] = int(m.group(1)) + int(m.group(2)), int(m.group(3))
        except (OSError, ValueError, IndexError):
            continue
        procs[int(nome)] = p
    return procs


def argumentos(pid):
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return f.read().split(b"\0")
    except OSError:
        return []


def nome_app(appid, raiz_steam):
    if appid in nomes_app:
        return nomes_app[appid]
    pastas = [raiz_steam, os.path.expanduser("~/.local/share/Steam")]
    for raiz in list(pastas):
        pastas += re.findall(r'"path"\s+"([^"]+)"', ler(raiz + "/steamapps/libraryfolders.vdf") or "")
    nome = None
    for pasta in dict.fromkeys(pastas):
        m = re.search(r'"name"\s+"([^"]+)"', ler("%s/steamapps/appmanifest_%s.acf" % (pasta, appid)) or "")
        if m:
            nome = m.group(1)
            break
    nomes_app[appid] = nome
    return nome


def mais_novo(padrao, desde):
    arqs = [(os.path.getmtime(a), a) for a in glob.glob(padrao)]
    arqs = [x for x in arqs if x[0] >= desde - 120]
    return max(arqs)[1] if arqs else None


def ticks_pz(arq):
    # the server writes "ping@pong" every 5 s with the tick counter (f:)
    achados = RE_PONG.findall(cauda(arq, 65536))[-4:]
    if len(achados) < 2:
        return None

    def quando(a):
        d, mes, ano, h, mi, s, ms = (int(x) for x in a[:7])
        return time.mktime((2000 + ano, mes, d, h, mi, s, 0, 0, -1)) + ms / 1000

    t0, t1 = quando(achados[0]), quando(achados[-1])
    if t1 <= t0 or time.time() - t1 > 30:
        return None
    return round((int(achados[-1][7]) - int(achados[0][7])) / (t1 - t0), 1)


def jogadores_pz(arq):
    try:
        marca = (os.path.getmtime(arq), os.path.getsize(arq), arq)
    except OSError:
        return None
    if cache_pz["con"][0] == marca:
        return cache_pz["con"][1]
    dentro = {}
    for evento, msg, guid, usuario in RE_CONEXAO.findall(cauda(arq, 2 << 20)):
        if evento == b"fully-connected":
            dentro[guid] = usuario.decode(errors="replace")
        elif evento == b"disconnect" or msg in (b"connection-lost", b"disconnection-notification"):
            dentro.pop(guid, None)
    nomes = sorted(dentro.values())
    cache_pz["con"] = (marca, nomes)
    return nomes


def info_pz(pid, p, args):
    # Only reads the end of the logs, nothing inside the save and no database opened.
    if cache_pz["pid"] == pid and time.monotonic() - cache_pz["quando"] < 10 and cache_pz["dados"]:
        return dict(cache_pz["dados"], kb=p["kb"])
    nome, pasta = "servidor", os.path.expanduser("~/Zomboid")
    for i, a in enumerate(args):
        if a == b"-servername" and i + 1 < len(args):
            nome = args[i + 1].decode(errors="replace")
        elif a.startswith(b"-cachedir="):
            pasta = a[10:].decode(errors="replace").rstrip("/") or pasta
    desde = BOOT + p["inicio"] / HZ
    d = {"nome": nome, "desde": desde, "kb": p["kb"], "ticks": None, "jogadores": None, "backup": None}
    arq = mais_novo(glob.escape(pasta) + "/Logs/*_DebugLog-server.txt", desde)
    if arq:
        d["ticks"] = ticks_pz(arq)
    arq = mais_novo(glob.escape(pasta) + "/Logs/*_connections.txt", desde)
    if arq:
        d["jogadores"] = jogadores_pz(arq)
    zips = glob.glob("/mnt/*/backup-pz-%s/%s_*.zip" % (glob.escape(nome), glob.escape(nome)))
    if zips:
        d["backup"] = max(os.path.getmtime(z) for z in zips)
    cache_pz.update(pid=pid, quando=time.monotonic(), dados=d)
    return d


def varredura():
    procs = varrer_processos()
    vram = dict(ult_vram)
    filhos = collections.defaultdict(list)
    for pid, p in procs.items():
        filhos[p["ppid"]].append(pid)

    def arvore(pid):
        pilha, todos = [pid], []
        while pilha:
            x = pilha.pop()
            todos.append(x)
            pilha.extend(filhos.get(x, ()))
        return todos

    nomes, raizes, soltos, pz, obs = {}, [], [], None, False
    for pid, p in procs.items():
        comm = p["comm"]
        nome = APELIDOS.get(comm) or (comm[:-4] if comm.lower().endswith(".exe") else comm)
        if comm == "obs":
            obs = cfg["modulos"]["live"]
        elif comm == "reaper":
            args = argumentos(pid)
            for a in args[:4]:
                if a.startswith(b"AppId="):
                    raiz = os.path.dirname(os.path.dirname(args[0].decode(errors="replace")))
                    raizes.append((pid, a[6:].decode(errors="replace"), raiz))
        elif comm in ("java", "ProjectZomboid6"):
            args = argumentos(pid)
            if b"zombie.network.GameServer" in args:
                nome = "Zomboid server"
                pz = info_pz(pid, p, args) if cfg["modulos"]["zomboid"] else None
            elif comm == "java" and any(b"minecraft" in a.lower() for a in args[:80]):
                nome = "Minecraft"
                soltos.append(pid)
        nomes[pid] = nome

    jogos, dentro_de_jogo, de_jogo = [], set(), {}
    for pid, appid, raiz in raizes:
        membros = [x for x in arvore(pid) if x in procs]
        dentro_de_jogo.update(membros)
        kb = sum(procs[x]["kb"] for x in membros)
        if kb < 51200:
            continue                    # still starting, or only the launcher
        maior = max(membros, key=lambda x: procs[x]["kb"])
        jogos.append({"nome": nome_app(appid, raiz) or nomes[maior], "desde": BOOT + procs[pid]["inicio"] / HZ,
                      "kb": kb, "vram": sum(vram.get(x, 0) for x in membros)})
        de_jogo.update({x: jogos[-1]["nome"] for x in membros})
    for pid in soltos:
        if pid not in dentro_de_jogo:
            jogos.append({"nome": nomes[pid], "desde": BOOT + procs[pid]["inicio"] / HZ,
                          "kb": procs[pid]["kb"], "vram": vram.get(pid, 0)})
    jogos.sort(key=lambda j: -j["kb"])

    agora = time.monotonic()
    dt = agora - ant_cpu["t"]
    ram, quantos, swap, uso = (collections.Counter() for _ in range(4))
    for pid, p in procs.items():
        if p["kb"]:
            ram[nomes[pid]] += p["kb"]
            swap[nomes[pid]] += p["swap"]
            quantos[nomes[pid]] += 1
        antes = ant_cpu["ticks"].get(pid)
        if antes is not None and p["ticks"] > antes and 0 < dt < 120:
            uso[nomes[pid]] += (p["ticks"] - antes) / HZ / dt * 100
    ant_cpu.update(t=agora, ticks={pid: p["ticks"] for pid, p in procs.items()})
    placa = collections.Counter()
    for pid, mib in vram.items():
        if mib > 0:
            placa[nomes.get(pid) or "pid %d" % pid] += mib
    extra.update(
        progs={"ram": [{"nome": n, "kb": kb, "n": quantos[n], "swap": swap[n]} for n, kb in ram.most_common(16)],
               "vram": [{"nome": n, "mib": m} for n, m in placa.most_common(16)],
               "cpu": [{"nome": n, "pct": round(v, 1)} for n, v in uso.most_common(16) if v >= 0.5]},
        jogos=jogos, pz=pz, obs=obs, nomes_pid={**nomes, **de_jogo})


def sockets_inet(proto):
    # every TCP or UDP socket of the machine through sock_diag (what "ss" reads, no root):
    # {inode: (remote end is this PC, bytes received, bytes sent and acked, state)}.
    # UDP sockets have no byte counters, so they are only counted.
    saida = {}
    s = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, 4)            # NETLINK_SOCK_DIAG
    try:
        s.settimeout(2)
        for fam in (socket.AF_INET, socket.AF_INET6):
            # inet_diag_req_v2: family, protocol, extensions (TCP: tcp_info), every state, any address
            req = struct.pack("=BBBBI", fam, proto, 2 if proto == socket.IPPROTO_TCP else 0, 0, 0xFFFFFFFF) + bytes(48)
            s.send(struct.pack("=IHHII", 16 + len(req), 20, 0x301, 1, 0) + req)   # SOCK_DIAG_BY_FAMILY, dump
            fim = False
            while not fim:
                buf = s.recv(65536)
                i = 0
                while i + 16 <= len(buf):
                    tam, tipo = struct.unpack_from("=IH", buf, i)
                    if tipo in (2, 3) or tam < 16:          # error or end of the dump
                        fim = True
                        break
                    m = i + 16                              # inet_diag_msg
                    estado, dst = buf[m + 1], buf[m + 24:m + 40]
                    inode = struct.unpack_from("=I", buf, m + 68)[0]
                    if buf[m] == socket.AF_INET:
                        local = dst[0] == 127
                    else:
                        local = dst == bytes(15) + b"\1" or (dst[:12] == bytes(10) + b"\xff\xff" and dst[12] == 127)
                    rx = tx = 0
                    a = m + 72
                    while a + 4 <= i + tam:
                        alen, atipo = struct.unpack_from("=HH", buf, a)
                        if alen < 4:
                            break
                        if atipo == 2 and alen - 4 >= 136:  # INET_DIAG_INFO: tcpi_bytes_acked, tcpi_bytes_received
                            tx, rx = struct.unpack_from("=QQ", buf, a + 4 + 120)
                        a += (alen + 3) & ~3
                    if inode:
                        saida[inode] = (local, rx, tx, estado)
                    i += (tam + 3) & ~3
    finally:
        s.close()
    return saida


class RedeProgs:
    # network use per program, measured only while the Network view is open: TCP bytes of
    # every socket summed per program (the sockets of a game count as the game), UDP and
    # TCP connections counted. Sockets are matched to programs through /proc/PID/fd, read
    # again only when an unknown socket shows up (at most every 10 s).
    def __init__(self):
        self.parar()

    def parar(self):
        self.ant, self.t, self.dono, self.varrido = {}, None, {}, 0.0

    def donos(self):
        m = {}
        for p in os.listdir("/proc"):
            if not p.isdigit():
                continue
            try:
                fds = os.listdir("/proc/%s/fd" % p)
            except OSError:
                continue
            for fd in fds:
                try:
                    alvo = os.readlink("/proc/%s/fd/%s" % (p, fd))
                except OSError:
                    continue
                if alvo.startswith("socket:["):
                    m[int(alvo[8:-1])] = int(p)
        self.dono, self.varrido = m, time.monotonic()

    def nome(self, pid):
        if pid is None:
            return ""                   # a socket of another user or of the system
        n = extra["nomes_pid"].get(pid)
        if n:
            return n
        comm = (ler("/proc/%d/comm" % pid) or "").strip()
        return APELIDOS.get(comm) or comm or "pid %d" % pid

    def medir(self):
        agora = time.monotonic()
        tcp, udp = sockets_inet(socket.IPPROTO_TCP), sockets_inet(socket.IPPROTO_UDP)
        faltam = any(i not in self.dono for i, x in tcp.items() if not x[0]) or any(i not in self.dono for i, x in udp.items() if not x[0])
        if (faltam and agora - self.varrido > 10) or agora - self.varrido > 60:
            self.donos()
        dt = agora - self.t if self.t else 0.0
        por, novo, conex = {}, {}, 0
        for i, (local, rx, tx, est) in tcp.items():
            if local:
                continue                # this PC talking to itself (the panel page among them)
            novo[i] = (rx, tx)
            x = por.setdefault(self.nome(self.dono.get(i)), [0.0, 0.0, 0, 0])
            if est == 1:
                x[2] += 1
                conex += 1
            if dt > 0:
                # a socket that was not there last time opened since then: all its bytes are new
                a = self.ant.get(i, (0, 0))
                x[0] += max(0, rx - a[0]) / dt
                x[1] += max(0, tx - a[1]) / dt
        nudp = 0
        for i, x in udp.items():
            if not x[0]:
                por.setdefault(self.nome(self.dono.get(i)), [0.0, 0.0, 0, 0])[3] += 1
                nudp += 1
        self.ant, self.t = novo, agora
        lista = sorted(por.items(), key=lambda kv: (-(kv[1][0] + kv[1][1]), -(kv[1][2] + kv[1][3])))
        extra["rede_progs"] = {"pronto": dt > 0, "tcp": conex, "udp": nudp,
                               "lista": [{"nome": n, "rx": round(v[0]), "tx": round(v[1]), "tcp": v[2], "udp": v[3]}
                                         for n, v in lista if v[0] or v[1] or v[2] or v[3]][:14]}


rede_progs = RedeProgs()


class LeitorFps:
    # FPS and frame times of the running game, read from the CSV log MangoHud writes when
    # MangoHud.conf has output_folder (and autostart_log). Each sample reads only the new
    # lines; with no game nothing is opened. MangoHud writes and flushes one line per
    # log_interval, columns fps,frametime,... after a few header lines.
    def __init__(self):
        self.pasta = None
        self.f = self.arq = None
        self.resto = b""
        self.cresceu = 0.0
        self.ult = None

    def achar_pasta(self):
        conf = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "MangoHud", "MangoHud.conf")
        pasta = None
        for linha in (ler(conf) or "").splitlines():
            k, _, v = linha.partition("=")
            if k.strip() == "output_folder" and v.split("#")[0].strip():
                pasta = os.path.expanduser(v.split("#")[0].strip())
        if pasta and not os.path.isdir(pasta) and self.temporaria(pasta):
            try:
                os.makedirs(pasta, exist_ok=True)      # /tmp is emptied at boot; MangoHud does not create it
            except OSError:
                pasta = None
        self.pasta = pasta if pasta and os.path.isdir(pasta) else None

    @staticmethod
    def temporaria(pasta):
        r = os.path.realpath(pasta) + os.sep
        return r.startswith(("/tmp/", (os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()) + os.sep))

    def fechar(self):
        if self.f:
            self.f.close()
        self.f = self.arq = self.ult = None
        self.resto = b""

    def mais_novo(self, desde):
        melhor, mt = None, desde - 5
        try:
            with os.scandir(self.pasta) as it:
                for e in it:
                    if e.name.endswith(".csv") and not e.name.endswith("_summary.csv"):
                        m = e.stat().st_mtime
                        if m > mt:
                            melhor, mt = e.path, m
        except OSError:
            return None
        return melhor if melhor and time.time() - mt < 15 else None

    def ler(self, jogo):
        # returns {"fps", "ft", "ft_max", "ft_lista"} for the time since the last call, or None
        if not jogo or not self.pasta:
            self.fechar()
            return None
        agora = time.time()
        if self.f is None or agora - self.cresceu > 15:
            novo = self.mais_novo(jogo["desde"])
            if novo and novo != self.arq:
                self.fechar()
                try:
                    self.f, self.arq, self.cresceu = open(novo, "rb"), novo, agora
                except OSError:
                    return None
        if self.f is None:
            return None
        try:
            dados = self.f.read(4 << 20)
        except OSError:
            self.fechar()
            return None
        if dados:
            self.cresceu = agora
        linhas = (self.resto + dados).split(b"\n")
        self.resto = linhas.pop()[-4096:]
        fps, ft = [], []
        for l in linhas:
            p = l.split(b",", 2)
            if len(p) < 3:
                continue
            try:
                a, b = float(p[0]), float(p[1])
            except ValueError:
                continue                    # header lines
            if a > 0 and 0 < b < 10000:
                fps.append(a)
                ft.append(b)
        if agora - self.cresceu > 6:
            self.ult = None                 # logging stopped (key pressed) or the game is paused
            return None
        if fps:
            self.ult = {"fps": round(sum(fps) / len(fps), 1), "ft": round(sum(ft) / len(ft), 2),
                        "ft_max": round(max(ft), 1), "ft_lista": ft}
            return self.ult
        return dict(self.ult, ft_lista=[]) if self.ult else None

    def limpar(self):
        # finished logs in a temporary folder take RAM (tmpfs): drop those idle for an hour
        if not self.pasta or not self.temporaria(self.pasta):
            return
        try:
            with os.scandir(self.pasta) as it:
                for e in it:
                    if e.name.endswith(".csv") and e.path != self.arq and time.time() - e.stat().st_mtime > 3600:
                        os.remove(e.path)
        except OSError:
            pass


leitor_fps = LeitorFps()


def info_live():
    try:
        c = http.client.HTTPConnection("127.0.0.1", PORTA_ESPECTADORES, timeout=8)
        c.request("GET", "/dados")
        d = json.loads(c.getresponse().read())
        c.close()
        return {"obs": True, "ok": True, "twitch": d.get("twitch"), "youtube": d.get("youtube"),
                "kick": d.get("kick"), "inicio": d.get("inicio"), "pico": d.get("pico", 0)}
    except (OSError, ValueError, http.client.HTTPException):
        return {"obs": True, "ok": False}


# ---------------------------------------------------------------- fast samples

class Medidor:
    def __init__(self):
        self.nv = Nvidia()
        self.amd = None
        self.ant = None
        self.pings = collections.deque(maxlen=60)
        self.pings_gw = collections.deque(maxlen=60)
        self.ult_gw = 0.0
        self.usos = collections.deque(maxlen=64)     # (time, processor use) for the 30 s average
        self.ult_ping = 0.0
        self.custo = collections.deque(maxlen=45)
        self.ft_lista = []

    def contadores(self):
        c = {"t": time.monotonic(), "cpu": [], "rede": None, "disco": {}}
        with open("/proc/stat") as f:
            for linha in f:
                if not linha.startswith("cpu"):
                    break
                v = [int(x) for x in linha.split()[1:9]]
                c["cpu"].append((sum(v) - v[3] - v[4], sum(v)))
        m = re.search(r"^pswpin (\d+)\npswpout (\d+)", ler("/proc/vmstat") or "", re.M)
        c["swap"] = int(m.group(1)) + int(m.group(2)) if m else 0
        c["ej"] = ler_int(RAPL) if RAPL else None
        if rota["iface"]:
            for linha in (ler("/proc/net/dev") or "").splitlines():
                nome, _, resto = linha.partition(":")
                if nome.strip() == rota["iface"]:
                    p = resto.split()
                    c["rede"] = (rota["iface"], int(p[0]), int(p[8]))
        # TCP segments sent and resent, UDP datagrams the PC itself dropped (IPv4 + IPv6)
        sn = {}
        for arq in ("/proc/net/snmp", "/proc/net/snmp6"):
            linhas = (ler(arq) or "").splitlines()
            if arq.endswith("6"):
                for linha in linhas:
                    k, _, v = linha.partition(" ")
                    if k in ("Udp6InErrors", "Udp6RcvbufErrors", "Udp6InDatagrams"):
                        sn[k[4:]] = sn.get(k[4:], 0) + int(v.strip() or 0)
                continue
            for cab, val in zip(linhas[::2], linhas[1::2]):
                if cab.startswith(("Tcp:", "Udp:")):
                    for k, v in zip(cab.split()[1:], val.split()[1:]):
                        if k in ("OutSegs", "RetransSegs", "InErrors", "RcvbufErrors", "InDatagrams"):
                            sn[k] = sn.get(k, 0) + int(v)
        c["snmp"] = sn
        nomes = {d["dev"] for d in discos}
        for linha in (ler("/proc/diskstats") or "").splitlines():
            p = linha.split()
            if len(p) > 12 and p[2] in nomes:
                # bytes read, bytes written, requests, ms waiting, ms busy, requests in flight
                c["disco"][p[2]] = (int(p[5]) * 512, int(p[9]) * 512, int(p[3]) + int(p[7]),
                                    int(p[6]) + int(p[10]), int(p[12]), int(p[11]))
        return c

    def medir(self):
        c = self.contadores()
        a, self.ant = self.ant, c
        dt = c["t"] - a["t"] if a else 0.0
        t = time.time()
        avisos, nv = [], {}

        def av(ident, cartao, n, pt, en):
            if n != "bom" and not silenciado(ident, t):
                avisos.append({"id": ident, "c": cartao, "nv": n, "pt": pt, "en": en})
            return n

        def psi(qual):
            m = re.search(r"some avg10=([\d.]+)", ler("/proc/pressure/" + qual) or "")
            return float(m.group(1)) if m else 0.0

        # processor
        usos = []
        if a and len(a["cpu"]) == len(c["cpu"]):
            for (o1, t1), (o2, t2) in zip(a["cpu"], c["cpu"]):
                usos.append(round(100.0 * (o2 - o1) / (t2 - t1), 1) if t2 > t1 else 0.0)
        mhz = [ler_int(x) or 0 for x in FREQS]
        tcpu = grau(fontes["cpu"])
        cpu = {"nome": NOME_CPU, "uso": usos[0] if usos else None, "nucleos": usos[1:], "temp": tcpu,
               "ghz": round(max(mhz) / 1e6, 2) if mhz else None, "carga": round(os.getloadavg()[0], 1),
               "psi": psi("cpu"), "watts": None}
        if a and dt > 0 and c["ej"] is not None and a["ej"] is not None:
            de = c["ej"] - a["ej"]
            if de < 0 and RAPL_MAX:
                de += RAPL_MAX              # the counter wrapped
            if de >= 0:
                cpu["watts"] = round(de / 1e6 / dt, 1)
        nv["cpu"] = nivel(tcpu, limite("temp_cpu"))
        if cpu["uso"] is not None:
            self.usos.append((t, cpu["uso"]))
        janela = [u for (q, u) in self.usos if t - q <= 31]
        lim_uso = limite("cpu_uso")
        if lim_uso and len(janela) >= 2 and t - self.usos[0][0] >= 20:
            media = sum(janela) / len(janela)
            topo = ((extra["progs"] or {}).get("cpu") or [None])[0]
            extra_pt = extra_en = ""
            if topo:
                extra_pt = ", mais usado: %s %d %%" % (topo["nome"], round(topo["pct"] / NCPU))
                extra_en = ", top: %s %d %%" % (topo["nome"], round(topo["pct"] / NCPU))
            n = av("cpu-uso", "cpu", nivel(media, lim_uso), "Processador em %d %% (média de 30 s)%s" % (media, extra_pt),
                   "Processor at %d %% (30 s average)%s" % (media, extra_en))
            nv["cpu"] = max(nv["cpu"], n, key=NIVEIS.index)
        topo = ((extra["progs"] or {}).get("cpu") or [None])[0]
        if topo:
            parte = topo["pct"] / NCPU
            av("prog-cpu", "prog", nivel(parte, limite("prog_cpu")), "%s usando %d %% do processador" % (topo["nome"], parte),
               "%s using %d %% of the processor" % (topo["nome"], parte))

        # memory
        mi = {}
        with open("/proc/meminfo") as f:
            for linha in f:
                k, _, v = linha.partition(":")
                mi[k] = int(v.split()[0])
        ram = {"total": mi["MemTotal"], "disp": mi["MemAvailable"], "usada": mi["MemTotal"] - mi["MemAvailable"],
               "left": max(0, mi["MemAvailable"] - cfg["ram_reserva"] * 1024), "reserva": cfg["ram_reserva"] * 1024,
               "cache": max(0, mi.get("Cached", 0) + mi.get("Buffers", 0) + mi.get("SReclaimable", 0) - mi.get("Shmem", 0)),
               "swap_total": mi["SwapTotal"], "swap": mi["SwapTotal"] - mi["SwapFree"],
               "swap_mibs": round((c["swap"] - a["swap"]) * PAGINA_KB / 1024 / dt, 2) if dt > 0 else 0.0,
               "psi": psi("memory")}
        left = ram["left"] // 1024
        lim_ram = limite("ram")
        nv["ram"] = nivel_min(left, lim_ram)
        if lim_ram and ram["swap_mibs"] > 0.5 and left < 512:
            nv["ram"] = "critico"
        av("ram", "ram", nv["ram"], "RAM livre em %d MiB" % left, "Free RAM at %d MiB" % left)
        if lim_ram and ram["psi"] >= 10:
            n2 = av("ram-psi", "ram", "serio", "PC engasgando por falta de RAM (pressão %d %%)" % ram["psi"],
                    "PC stalling for lack of RAM (pressure %d %%)" % ram["psi"])
            nv["ram"] = max(nv["ram"], n2, key=NIVEIS.index)

        # graphics card
        gpu, procs = self.nv.medir() if os.environ.get("PC_PANEL_GPU") != "amd" else ({"ok": False}, {})
        if not gpu["ok"] and (self.nv.ausente or os.environ.get("PC_PANEL_GPU") == "amd"):
            # no NVIDIA: try an AMD card; with none, the card tiles disappear instead of raising an alarm
            self.amd = self.amd or Amd()
            gpu, procs = self.amd.medir() if self.amd.dev else ({"ok": False, "ausente": True, "erro": ("", "")}, {})
        ult_vram.clear()
        ult_vram.update(procs)
        if gpu["ok"]:
            pct = 100.0 * gpu["vram"] / gpu["vram_total"]
            nv["vram"] = av("vram", "vram", nivel(pct, limite("vram")), "VRAM em %d %%" % pct, "VRAM at %d %%" % pct)
            nv["gpu"] = nivel(gpu["temp"], limite("temp_gpu"))
        elif gpu.get("ausente"):
            nv["vram"] = nv["gpu"] = "bom"
            gpu["erro"] = {"pt": "", "en": ""}
        else:
            pt, en = gpu["erro"]
            nv["vram"] = nv["gpu"] = av("gpu", "gpu", "serio", "Placa de vídeo sem leitura, " + pt,
                                        "Graphics card not readable, " + en)
            gpu["erro"] = {"pt": pt, "en": en}

        # network
        rx = tx = None
        if dt > 0 and a["rede"] and c["rede"] and a["rede"][0] == c["rede"][0]:
            rx = max(0, c["rede"][1] - a["rede"][1]) / dt
            tx = max(0, c["rede"][2] - a["rede"][2]) / dt
        quando, ping = pings["net"]
        if t - quando > 25:
            ping = None
        elif quando != self.ult_ping and ping is not None:
            self.ult_ping = quando
            self.pings.append(ping)
        quando, gw = pings["gw"]
        if t - quando > 25:
            gw = None
        elif quando != self.ult_gw and gw is not None:
            self.ult_gw = quando
            self.pings_gw.append(gw)

        def qualidade(fila):
            # loss %, median of the last 8 answers, jitter (mean change between answers)
            bons = [x for x in fila if x >= 0]
            perda = 100.0 * (len(fila) - len(bons)) / len(fila) if fila else 0.0
            rec = sorted(bons[-8:])
            med = rec[len(rec) // 2] if rec else None
            osc = sum(abs(bons[i] - bons[i - 1]) for i in range(1, len(bons))) / (len(bons) - 1) if len(bons) > 2 else None
            return perda, med, osc

        perda, med, osc = qualidade(self.pings)
        perda_gw, med_gw, osc_gw = qualidade(self.pings_gw)
        sa, sc = (a or {}).get("snmp") or {}, c.get("snmp") or {}
        dif = lambda k: max(0, sc.get(k, 0) - sa.get(k, 0)) if sa else None
        seg, reenv = dif("OutSegs"), dif("RetransSegs")
        retx = round(100.0 * reenv / seg, 2) if seg else (0.0 if seg == 0 else None)
        udp_perd = dif("InErrors")
        cheia = len(self.pings) >= 10
        # where the trouble is: between the PC and the router, beyond it, or in the PC itself
        diag = "ok"
        if not rota["iface"]:
            diag = "sem"
        elif len(self.pings_gw) >= 10 and (perda_gw >= 2 or (med_gw or 0) > (30 if rota["wifi"] else 15)):
            diag = "roteador"
        elif cheia and (perda >= 2 or nivel(med, limite("ping")) != "bom" or nivel(osc, limite("jitter")) != "bom"):
            diag = "internet"
        elif udp_perd:
            diag = "pc"
        wifi = None
        if rota["wifi"]:
            for linha in (ler("/proc/net/wireless") or "").splitlines()[2:]:
                p = linha.split()
                if p and p[0].rstrip(":") == rota["iface"] and len(p) > 3:
                    wifi = float(p[3].rstrip("."))
        rede = {"iface": rota["iface"], "ip": rota["ip"], "rx": rx, "tx": tx, "ping": ping, "gw": gw,
                "alvo": cfg["ping_alvo"], "perda": round(perda, 1), "osc": None if osc is None else round(osc, 1),
                "med": med, "gw_med": med_gw, "gw_perda": round(perda_gw, 1),
                "gw_osc": None if osc_gw is None else round(osc_gw, 1), "n": len(self.pings), "gw_n": len(self.pings_gw),
                "retx": retx, "udp_perd": udp_perd, "udp_buf": sc.get("RcvbufErrors"), "udp_err": sc.get("InErrors"),
                "rx_tot": c["rede"][1] if c["rede"] else None, "tx_tot": c["rede"][2] if c["rede"] else None,
                "link": rota["link"], "erros": rota["erros"], "descartes": rota["descartes"], "mtu": rota["mtu"],
                "duplex": rota["duplex"], "wifi": wifi, "diag": diag}
        if not rota["iface"]:
            nv["rede"] = av("rede", "rede", "critico", "Sem rede", "No network")
        else:
            n1 = av("ping", "rede", nivel(med, limite("ping")), "Ping em %d ms" % (med or 0), "Ping at %d ms" % (med or 0))
            n2 = av("perda", "rede", nivel(perda if cheia else None, limite("perda")),
                    "Perda de pacotes em %d %%" % round(perda), "Packet loss at %d %%" % round(perda))
            n3 = av("jitter", "rede", nivel(osc if cheia else None, limite("jitter")),
                    "Oscilação do ping em %d ms" % round(osc or 0), "Ping jitter at %d ms" % round(osc or 0))
            nv["rede"] = max(n1, n2, n3, key=NIVEIS.index)

        # temperatures, fans and disks
        temps = [{"id": "cpu", "nome": "", "c": tcpu}, {"id": "gpu", "nome": "", "c": gpu.get("temp")}]
        lista_discos = []
        for d in discos:
            antes, depois = (a["disco"].get(d["dev"]) if a else None), c["disco"].get(d["dev"])
            io = {"ler": None, "gravar": None, "espera": None, "ocupado": None}
            nd = "bom"
            nome_pt, nome_en = ("Sistema", "System") if d["nome"] == "/" else (d["nome"], d["nome"])
            if antes and depois and dt > 0:
                pedidos = depois[2] - antes[2]
                espera = (depois[3] - antes[3]) / pedidos if pedidos > 0 else 0.0
                io = {"ler": (depois[0] - antes[0]) / dt, "gravar": (depois[1] - antes[1]) / dt,
                      "espera": round(espera, 1), "ocupado": round(min(100.0, (depois[4] - antes[4]) / (dt * 10)), 1)}
                if pedidos == 0 and depois[5] > 0 and dt >= 0.9:
                    nd = av("disco-preso-" + d["dev"], "disc", "critico", "Disco %s parado com pedidos na fila" % nome_pt,
                            "Disk %s stuck with requests queued" % nome_en)
                elif pedidos >= 3 and espera >= 250:
                    nd = av("disco-lento-" + d["dev"], "disc", "serio", "Disco %s lento, espera de %d ms" % (nome_pt, espera),
                            "Disk %s slow, %d ms wait" % (nome_en, espera))
            tdisco = grau(d["temp_arq"])
            if tdisco:
                temps.append({"id": "ssd", "nome": d["nome"], "c": tdisco})
            usado = round(100.0 * (1 - d["livre"] / d["total"]), 1) if d["total"] else 0.0
            n2 = av("disco-" + d["dev"], "disc", nivel(usado, limite("disco")), "Disco %s com %d %% ocupado" % (nome_pt, usado),
                    "Disk %s %d %% full" % (nome_en, usado))
            h = ssd.get(d["dev"])
            n3 = "bom"
            if h:
                h = dict(h)
                if h["gasto"] is not None:
                    n3 = av("ssd-gasto-" + d["dev"], "disc", nivel(h["gasto"], limite("ssd_desgaste")),
                            "SSD %s com %d %% da vida útil gasta" % (nome_pt, h["gasto"]), "SSD %s has used %d %% of its life" % (nome_en, h["gasto"]))
                k = cfg["limites"]["ssd_saude"]
                if h["problema"] and k["on"]:
                    n3 = max(n3, av("ssd-saude-" + d["dev"], "disc", k["nv"], "SSD %s: %s" % (nome_pt, h["problema"][0]),
                                    "SSD %s: %s" % (nome_en, h["problema"][1])), key=NIVEIS.index)
                h["nv"] = n3
            lista_discos.append(dict(io, nome=d["nome"], modelo=d["modelo"], total=d["total"], livre=d["livre"],
                                     usado=usado, saude=h, nv=max(nd, n2, n3, key=NIVEIS.index)))
        temps.append({"id": "placa", "nome": "", "c": grau(fontes["placa"])})
        tmem = [x for x in (grau(m) for m in fontes["mem"]) if x]
        temps.append({"id": "mem", "nome": "", "c": max(tmem) if tmem else None})
        temps = [x for x in temps if x["c"]]
        for x in temps:
            if x["id"] == "ssd":
                pt, en = ("SSD Sistema", "System SSD") if x["nome"] == "/" else ("SSD " + x["nome"], "SSD " + x["nome"])
            else:
                pt, en = NOME_TEMP[x["id"]]
            lim = limite(TEMP_METRICA[x["id"]], x["nome"])
            x["lim"] = next((y for y in lim if y is not None), None) if lim else None
            x["nv"] = av("temp-" + x["id"] + x["nome"], "temp", nivel(x["c"], lim),
                         "%s a %d °C" % (pt, round(x["c"])), "%s at %d °C" % (en, round(x["c"])))
        canais = []
        for n in cfg["canais"]:
            base = "%s/pwm%s" % (fontes["chip"], n)
            pwm = ler_int(base)
            canais.append({"n": n, "rpm": ler_int("%s/fan%s_input" % (fontes["chip"], n)) or 0,
                           "pct": None if pwm is None else round(pwm / 2.55), "modo": ler_int(base + "_enable")})
        if fans["calibrando"] is None:
            for x in canais:
                if x["rpm"] == 0:
                    av("fan-parada-" + x["n"], "temp", "serio", "Fan %s da placa-mãe parada" % x["n"],
                       "Motherboard fan %s stopped" % x["n"])

        # what is running
        jogos, pz, sis, sd = extra["jogos"], extra["pz"], extra["sis"], extra["saude"]
        jogo = jogos[0]["nome"] if jogos else None
        quadros = leitor_fps.ler(jogos[0] if jogos else None)
        self.ft_lista = quadros.pop("ft_lista") if quadros else []
        if pz:
            if pz["ticks"] is not None:
                av("pz-ticks", "pz", nivel_min(pz["ticks"], (8.5, 6, 4)), "Servidor do Zomboid a %.1f ticks/s" % pz["ticks"],
                   "Zomboid server at %.1f ticks/s" % pz["ticks"])
            if pz["backup"] and t - pz["backup"] > 1500:
                av("pz-backup", "pz", "aviso", "Último backup do servidor há %d min" % ((t - pz["backup"]) / 60),
                   "Last server backup %d min ago" % ((t - pz["backup"]) / 60))
        for unidade in sis["falhas"]:
            av("falha-" + unidade, "saude", "aviso", "Serviço %s falhou" % unidade, "Service %s failed" % unidade)
        bat = sis["bateria"]
        lim_bat = limite("bateria")
        if bat and lim_bat and not bat["carregando"]:
            av("bateria", "sis", nivel_min(bat["pct"], lim_bat), "%s com %d %% de bateria" % (bat["nome"], bat["pct"]),
               "%s battery at %d %%" % (bat["nome"], bat["pct"]))
        proteger_fans(gpu.get("temp"), tcpu)
        guiar_gpu(gpu.get("temp"))
        with trava_ev:
            acompanhar(avisos, t, jogo)
            mudos = {k: round(v) for k, v in silencio.items() if v > t}
        avisar_bandeja()

        self.custo.append((time.monotonic(), time.process_time()))
        (m0, p0), (m1, p1) = self.custo[0], self.custo[-1]
        proprio = {"cpu": round(100 * (p1 - p0) / (m1 - m0), 2) if m1 > m0 else None,
                   "mib": int((ler("/proc/self/statm") or "0 0").split()[1]) * PAGINA_KB // 1024}
        ligado = float((ler("/proc/uptime") or "0").split()[0])
        lento = ritmo()
        agora = {"t": round(t, 2), "cpu": cpu, "ram": ram, "gpu": gpu, "rede": rede, "temps": temps,
                 "fans": {"canais": canais, "pode": fans["pode"], "escolha": cfg["fans"], "aplicado": fans["aplicado"],
                          "alvo_gpu": curva_gpu["alvo"], "calibrando": fans["calibrando"], "velho": fans["velho"]},
                 "discos": lista_discos, "psi_io": psi("io"),
                 "progs": extra["progs"], "jogos": jogos, "live": extra["live"], "pz": pz,
                 "sis": dict(sis, ligado=ligado, driver=gpu.get("driver"), painel=proprio),
                 "saude": dict(sd, falhas=len(sis["falhas"]), npac=len(upd["pacotes"]),
                               upd={k: upd[k] for k in ("quando", "flatpak", "fora", "erro", "rodando")}),
                 "nv": nv, "avisos": avisos, "silencio": mudos,
                 "jogando": jogando(), "sessao": sessoes.resumo(sessoes.atual), "fps": quadros,
                 "fps_log": leitor_fps.pasta is not None,
                 "rede_progs": extra["rede_progs"] if time.monotonic() - rede_pedida[0] < 15 else None,
                 "ev": ev_seq[0], "cfg": cfg_seq[0], "registro": cfg["registro"]["ligado"],
                 "espaco": lento[0] or float(cfg["passo"])}
        linha = [round(t, 1), round(ram["usada"] / 1048576, 2),
                 round(gpu["vram"] / 1024, 2) if gpu["ok"] else None, gpu.get("uso"), cpu["uso"],
                 ping, round(rx * 8 / 1e6, 3) if rx is not None else None,
                 round(tx * 8 / 1e6, 3) if tx is not None else None, tcpu, gpu.get("temp"), gw,
                 quadros["fps"] if quadros else None, quadros["ft_max"] if quadros else None]
        registro.medida(agora)
        return linha, agora


def laco_medir():
    global seq, estado
    m = Medidor()
    dormindo = True
    while True:
        passo = ritmo()[0]
        if passo is None:
            dormindo = True
            apagar_dica()               # nothing is measured, the tooltip would go stale
            acordar.wait(30)            # a page request or a settings change sets it
            acordar.clear()
            continue
        try:
            if dormindo:
                m.ant = m.contadores()      # reset the rate counters
                time.sleep(0.5)
                dormindo = False
            linha, agora = m.medir()
            with trava:
                hist.append(linha)
                seq += 1
                estado = agora
            with novo:
                novo.notify_all()
            if cfg["caixa"]:
                caixa.anotar(agora)
                h24.anotar(agora)
            sessoes.anotar(agora, m.ft_lista)
            escrever_dica(agora)
        except Exception as e:              # never die because of one reading
            avisar("medir", e)
        ultima = time.monotonic()
        while True:
            # a page opening in the middle of a long wait wakes it up early
            passo = ritmo()[0]
            resto = ultima + (passo or 0) - time.monotonic()
            if passo is None or resto <= 0:
                break
            if acordar.wait(resto):
                acordar.clear()
                if time.monotonic() - ultima < 0.5:
                    time.sleep(0.5)


def laco_lento():
    venc = collections.defaultdict(float)

    def vence(nome, cada):
        agora = time.monotonic()
        if agora >= venc[nome]:
            venc[nome] = agora + cada
            return True
        return False

    era_aberta = False
    while True:
        passo, aberta = ritmo()
        if passo is None:
            cochilar(30)
            continue
        if aberta and not era_aberta:
            # the page just opened: refresh what the background watch reads slowly
            for nome in ("fans", "procs", "sis"):
                venc[nome] = 0.0
        era_aberta = aberta
        try:
            if vence("fontes", 60):
                achar_fontes()
                preparar_fans()
                leitor_fps.achar_pasta()
            if vence("fps_limpa", 600):
                leitor_fps.limpar()
            if vence("rota", 30):
                achar_rota()
            if vence("discos", 30):
                achar_discos()
            leve = cfg["jogo"]["leve"] and extra["jogos"]
            if vence("fans", (6 if leve else 3) if aberta else 30):
                ler_fans()
            if vence("procs", (10 if leve else 4) if aberta else 30):
                varredura()
            if time.monotonic() - rede_pedida[0] < 15:
                if vence("rede_progs", 10 if leve else 5):
                    rede_progs.medir()
            else:
                venc.pop("rede_progs", None)    # a past due time would wake this loop every 0.5 s
                if rede_progs.t is not None:
                    rede_progs.parar()
                    extra["rede_progs"] = None
            if vence("ssd", 1800):
                saude_ssd()
            if vence("h24", 900):
                h24.salvar()
            if vence("sis", 60 if aberta else 300):
                extra["sis"] = info_sistema()
            if vence("saude", 120 if aberta or cfg["alertas"]["fundo"] else 900):
                info_saude()
        except Exception as e:
            avisar("lento", e)
        # sleep until the next task is due instead of checking twice a second
        cochilar(min(30.0, max(0.5, min(venc.values()) - time.monotonic())))


def um_ping(socks, ip, n, espera=1.0):
    # ICMP echo without root (Linux "ping" socket); -1 = lost, None = no network
    try:
        s = socks.get(ip)
        if s is None:
            s = socks[ip] = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_ICMP)
        num = n & 0xFFFF
        inicio = time.perf_counter()
        s.settimeout(espera)
        s.sendto(struct.pack("!BBHHH", 8, 0, 0, 0, num) + b"pc-panel", (ip, 0))
        while True:
            resto = espera - (time.perf_counter() - inicio)
            if resto <= 0:
                return -1
            s.settimeout(resto)
            dados = s.recv(256)
            if len(dados) >= 8 and dados[0] == 0 and struct.unpack("!H", dados[6:8])[0] == num:
                return round((time.perf_counter() - inicio) * 1000, 2)
    except TimeoutError:
        return -1
    except OSError:
        velho = socks.pop(ip, None)
        if velho:
            velho.close()
        return None


def laco_ping():
    socks, n = {}, 0
    while True:
        passo = ritmo()[0]
        if passo is None:
            cochilar(30)
            continue
        inicio, n = time.monotonic(), n + 1
        for chave, ip in (("gw", rota["gw"]), ("net", cfg["ping_alvo"])):
            pings[chave] = (time.time(), um_ping(socks, ip, n) if ip else None)
        while True:
            passo = ritmo()[0]
            resto = inicio + max(2.0, passo or 0) - time.monotonic()   # ping at most every 2 s
            if passo is None or resto <= 0:
                break
            cochilar(resto)


def laco_live():
    while True:
        passo, aberta = ritmo()
        if extra["obs"] and passo is not None:
            extra["live"] = info_live()
            time.sleep(10 if aberta else 30)
        else:
            if not extra["obs"]:
                extra["live"] = {"obs": False}
            cochilar(5)


# ---------------------------------------------------------------- web server

pagina_cache = {"m": None, "b": b""}


def pagina():
    try:
        m = os.path.getmtime(ARQ_PAGINA)
        if m != pagina_cache["m"]:
            with open(ARQ_PAGINA, "rb") as f:
                pagina_cache.update(m=m, b=f.read())
        return pagina_cache["b"]
    except OSError:
        return ("<h1>pc-panel</h1><p>Missing file %s</p>" % os.path.realpath(ARQ_PAGINA)).encode()


def info_geral():
    return {"cfg": cfg, "recomendados": recomendados(), "recomendados_jogo": recomendados_jogo(), "metricas": {m: d[0] for m, d in METRICAS.items()}, "info": registro.info(), "upd": dict(upd), "curvas": CURVAS, "curva_gpu": CURVA_GPU,
            "versao": VERSAO, "metodo": metodo_instalacao(), "novidade": {k: v for k, v in novidade.items() if k != "arquivos"}}


class Pedido(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    timeout = 60

    def do_GET(self):
        # only answers this machine and only under the right name (an outside site
        # cannot read the data through the browser)
        if self.headers.get("Host") not in HOSTS:
            self.send_error(403)
            return
        u = urlsplit(self.path)
        if u.path == "/dados":
            qs = parse_qs(u.query)
            try:
                desde = int(qs.get("desde", ["0"])[0])
            except ValueError:
                desde = 0
            if qs.get("i", [""])[0] != INSTANCIA:
                desde = 0
            abriu = not assistindo()
            visto[0] = time.time()
            if qs.get("rede") == ["1"]:
                if time.monotonic() - rede_pedida[0] > 15:
                    despertar()     # the slow loop may be asleep for up to 30 s
                rede_pedida[0] = time.monotonic()
            if abriu:
                despertar()         # the page just opened: every loop switches to the fast pace
            else:
                acordar.set()
            passo = passo_pagina()
            if time.time() - estado["t"] > passo * 2 + 1:
                with novo:
                    novo.wait(3.0)      # it was sleeping or slow, wait for a fresh sample
            with trava:
                faltam = seq - desde if desde else len(hist)
                corpo = {"i": INSTANCIA, "seq": seq, "passo": passo, "agora": estado,
                         "hist": list(hist)[-faltam:] if faltam > 0 else []}
            self.json(corpo)
        elif u.path == "/config":
            self.json(info_geral())
        elif u.path == "/eventos":
            self.json({"eventos": list(eventos)[-200:]})
        elif u.path == "/sensores":
            self.json({"grupos": todos_sensores()})
        elif u.path == "/caixa":
            ident = parse_qs(u.query).get("id", [""])[0]
            if ident:
                inc = caixa.um(ident)
                if inc:
                    self.json(inc)
                else:
                    self.send_error(404)
            else:
                self.json({"incidentes": caixa.lista(), "cada": caixa.CADA, "slots": caixa.SLOTS, "ativa": caixa.fd is not None})
        elif u.path == "/historico24":
            self.json(h24.dados())
        elif u.path == "/sessoes":
            self.json({"sessoes": sessoes.lista(), "atual": sessoes.resumo(sessoes.atual)})
        elif u.path == "/registro/hoje.csv":
            nome = time.strftime("painel-%Y-%m-%d.csv")
            try:
                with open(os.path.join(registro.pasta(), nome), "rb") as f:
                    self.responder(f.read(), "text/csv; charset=utf-8", nome)
            except OSError:
                self.send_error(404)
        elif u.path in ("/", "/index.html"):
            self.responder(pagina(), "text/html; charset=utf-8")
        else:
            self.send_error(404)

    def do_POST(self):
        # the custom header and the checked origin stop another site open in
        # the browser from sending commands here
        origem = self.headers.get("Origin")
        if (self.headers.get("Host") not in HOSTS or self.headers.get("X-Painel") != "1"
                or (origem and origem not in ORIGENS)):
            self.send_error(403)
            return
        try:
            tamanho = int(self.headers.get("Content-Length", "0"))
            if not 0 < tamanho <= 32768:
                raise ValueError
            dados = json.loads(self.rfile.read(tamanho))
        except ValueError:
            self.send_error(400)
            return
        caminho = urlsplit(self.path).path
        pt = cfg["idioma"] == "pt"

        def erro(par):
            self.json({"erro": par[0] if pt else par[1]})

        sem_fans = ("O controle das fans não está instalado neste PC.", "Fan control is not installed on this PC.")
        if caminho == "/config":
            nova, falha = limpar_cfg(dados, cfg)
            if not falha:
                try:
                    salvar_cfg(nova)
                except OSError as e:
                    falha = ("Não consegui salvar a configuração (%s)" % e.strerror,
                             "Could not save the settings (%s)" % e.strerror)
            despertar()
            if falha:
                erro(falha)
            else:
                self.json(info_geral())
        elif caminho == "/fans":
            ler_fans()
            if not fans["pode"] or cfg["fans"] is None:
                erro(sem_fans)
                return
            if fans["calibrando"] is not None:
                erro(("Espere a medição das fans terminar.", "Wait for the fan measurement to finish."))
                return
            if fans["velho"]:
                erro(VELHO)
                return
            if not isinstance(dados, dict):
                dados = {}
            for grupo, minimo in (("gpu", 30),) + tuple((c, 20) for c in cfg["canais"]):
                x = dados.get("gpu") if grupo == "gpu" else (dados.get("placa") or {}).get(grupo)
                if isinstance(x, dict) and x.get("modo") == "curva" and not pontos_validos(x.get("pontos"), minimo):
                    erro(("Curva inválida: os graus precisam subir a cada ponto e a porcentagem não pode descer.",
                          "Invalid curve: degrees must go up at each point and the percentage cannot go down."))
                    return
            nova = copia(cfg)
            nova["fans"] = limpar_fans(dados, cfg["canais"])
            if isinstance(dados.get("nomes"), dict):
                nova["nomes_fans"] = {c: str(dados["nomes"].get(c, ""))[:24].strip() for c in cfg["canais"]}
            antes = (fans["aplicado"] or {}).get("t")
            try:
                salvar_cfg(nova)
                alvo = None
                if nova["fans"]["gpu"]["modo"] == "curva":
                    alvo = alvo_da_curva((estado.get("gpu") or {}).get("temp"))
                curva_gpu.update(alvo=alvo, quando=time.monotonic())
                gravar_comando(alvo)
            except OSError as e:
                erro(("Não consegui gravar a escolha (%s)" % e.strerror, "Could not save the choice (%s)" % e.strerror))
                return
            fim = time.monotonic() + 4      # wait for the root helper to apply
            while time.monotonic() < fim:
                time.sleep(0.15)
                ler_fans()
                if (fans["aplicado"] or {}).get("t") != antes:
                    break
            else:
                erro(("A escolha foi gravada, mas o ajudante das fans não respondeu.",
                      "The choice was saved, but the fan helper did not answer."))
                return
            despertar()
            self.json({"escolha": cfg["fans"], "aplicado": fans["aplicado"], "nomes": cfg["nomes_fans"]})
        elif caminho == "/fans/calibrar":
            if not fans["pode"] or cfg["fans"] is None or not cfg["canais"]:
                erro(sem_fans)
                return
            if fans["velho"]:
                erro(VELHO)
                return
            threading.Thread(target=calibrar, daemon=True).start()
            self.json({"ok": True})
        elif caminho == "/silenciar":
            ident, minutos = dados.get("id") if isinstance(dados, dict) else None, (dados or {}).get("min")
            if not isinstance(ident, str) or not 0 < len(ident) <= 120 or minutos not in (0, 15, 60, 180):
                self.send_error(400)
                return
            silenciar(ident, minutos)
            despertar()
            with trava_ev:
                mudos = {k: round(v) for k, v in silencio.items()}
            self.json({"silencio": mudos})
        elif caminho == "/atualizacoes":
            threading.Thread(target=verificar_atualizacoes, daemon=True).start()
            self.json({"ok": True})
        elif caminho == "/versao":
            procurar_versao()
            self.json(info_geral())
        elif caminho == "/atualizar":
            falha, senha = atualizar_painel()
            if falha:
                erro(falha)
            else:
                self.json({"ok": True, "senha": senha})
        else:
            self.send_error(404)

    def json(self, corpo):
        self.responder(json.dumps(corpo, separators=(",", ":"), ensure_ascii=False).encode(), "application/json")

    def responder(self, corpo, tipo, baixar=None):
        self.send_response(200)
        self.send_header("Content-Type", tipo)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(corpo)))
        if baixar:
            self.send_header("Content-Disposition", 'attachment; filename="%s"' % baixar)
        self.end_headers()
        self.wfile.write(corpo)

    def log_message(self, *args):
        pass


def sair(*_):
    try:
        sessoes.fechar()
        with h24.trava:
            h24.fechar()
        h24.salvar()
    except Exception as e:
        avisar("sair", e)
    ao_parar()
    os._exit(0)


def prioridade_minima():
    # never compete with a game: lowest processor class (SCHED_IDLE runs only on idle
    # time) and idle disk class. Threads and helper commands started later inherit it.
    try:
        os.sched_setscheduler(0, os.SCHED_IDLE, os.sched_param(0))
    except (AttributeError, OSError) as e:
        avisar("prioridade", e)
    nr = {"x86_64": 251, "aarch64": 30, "riscv64": 30}.get(os.uname().machine)     # ioprio_set
    if nr:
        ctypes.CDLL(None, use_errno=True).syscall(nr, 1, 0, 3 << 13)       # IOPRIO_WHO_PROCESS, self, IOPRIO_CLASS_IDLE


if __name__ == "__main__":
    if "--version" in sys.argv:
        print("pc-panel", VERSAO)
        sys.exit(0)
    if "--on-stop" in sys.argv:
        ao_parar()
        sys.exit(0)
    prioridade_minima()
    carregar_cfg()
    h24.carregar()
    caixa.iniciar()
    caixa.avisar_novo()
    try:
        upd.update(json.loads(ler(ARQ_UPD) or "{}"))
    except ValueError:
        pass
    achar_fontes()
    achar_rota()
    achar_discos()
    ler_fans()
    preparar_fans()
    if fans["pode"] and cfg["fans"]["gpu"]["modo"] != "curva":
        try:
            gravar_comando(so_se_mudou=True)    # keep the command file equal to the saved choice
        except OSError as e:
            avisar("fans", e)
    signal.signal(signal.SIGTERM, sair)
    for laco in (laco_medir, laco_lento, laco_ping, laco_live):
        threading.Thread(target=laco, daemon=True).start()
    # SIGTERM exits through sair(), never through shutdown(), so the server needs no polling
    ThreadingHTTPServer((ENDERECO, PORTA), Pedido).serve_forever(poll_interval=3600)
