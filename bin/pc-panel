NIVEIS = ("bom", "aviso", "serio", "critico")
# degrees at which a reading becomes warning, high and critical
# Alert thresholds. Each one is on or off, and either "recommended" (worked out from
# the limits this hardware reports, see recomendados()) or three values of the user's own
# for warning, serious and critical. A level left empty (None) is skipped.
# id -> (direction: "alto" = higher is worse, "baixo" = lower is worse, "evento" = no number; lowest; highest)
METRICAS = {
    "ram": ("baixo", 0, 1048576), "vram": ("alto", 1, 100), "cpu_uso": ("alto", 1, 100), "prog_cpu": ("alto", 1, 100),
    "temp_cpu": ("alto", 20, 130), "temp_gpu": ("alto", 20, 130), "temp_ssd": ("alto", 20, 130),
    "temp_mem": ("alto", 20, 130), "temp_placa": ("alto", 20, 130), "disco": ("alto", 1, 100),
    "ping": ("alto", 1, 10000), "perda": ("alto", 0.1, 100), "jitter": ("alto", 1, 1000), "bateria": ("baixo", 1, 99), "ssd_desgaste": ("alto", 1, 100),
    "kernel": ("evento", 0, 0), "travou": ("evento", 0, 0), "parou": ("evento", 0, 0), "ssd_saude": ("evento", 0, 0),
}
NIVEL_EVENTO = {"parou": "serio", "ssd_saude": "critico"}     # default level of the one-off alerts, the rest start at "aviso"
