class Falha(Exception):
    """error with a Portuguese and an English message"""


def ler(caminho):
    try:
        with open(caminho) as f:
            return f.read()
    except OSError:
        return None


def ler_int(caminho):
    try:
        with open(caminho) as f:
            return int(f.read())
    except (OSError, ValueError, TypeError):
        return None


def grau(caminho):
    v = ler_int(caminho) if caminho else None
    return round(v / 1000, 1) if v else None


def avisar(onde, erro):
    print("pc-panel: %s: %r" % (onde, erro), file=sys.stderr, flush=True)


def copia(d):
    return json.loads(json.dumps(d))


def numero(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def nivel(v, lim):          # the higher, the worse; lim is (warning, serious, critical), any may be None
    if v is None or not lim:
        return "bom"
    return NIVEIS[max([i + 1 for i, x in enumerate(lim) if x is not None and v >= x] or [0])]


def nivel_min(v, lim):      # the lower, the worse
    if v is None or not lim:
        return "bom"
    return NIVEIS[max([i + 1 for i, x in enumerate(lim) if x is not None and v <= x] or [0])]


def limite_do_sensor(arq):
    # (max, crit) in degrees that the chip itself reports next to a temperature input, when sane
    if not arq or not arq.endswith("_input"):
        return None, None
    base = arq[:-6]

    def v(sufixo):
        x = ler_int(base + sufixo)
        return x / 1000 if x and 30000 <= x <= 150000 else None
    return v("_max"), v("_crit")


def tjmax_amd(nome):
    # AMD publishes Tjmax per model; the k10temp driver does not report it
    if re.search(r"\b7\d00X3D", nome):
        return 89
    if re.search(r"\b5\d00X3D|\b5[89]\d0X\b|\b5[89]\d0\b", nome):
        return 90
    return 95


rec_cache = {"t": 0.0, "v": None}


def recomendados():
    # recommended thresholds for this PC, from what the hardware says about itself
    if rec_cache["v"] and time.monotonic() - rec_cache["t"] < 60:
        return rec_cache["v"]
    total = ler_int_meminfo("MemTotal") // 1024
    r = {"ram": [max(256, round(total * f / 64) * 64) for f in (0.10, 0.04, 0.015)],
         "vram": [85, 93, 97], "cpu_uso": [90, 97, None], "prog_cpu": [80, 95, None],
         "disco": [85, 93, 97], "ping": [60, 100, 180], "perda": [2, 6, 20], "jitter": [20, 40, 80], "temp_placa": [55, 65, 75],
         "bateria": [15, 8, 3], "ssd_desgaste": [80, 90, 97]}
    fonte = {"temp_cpu": "", "temp_gpu": "", "temp_mem": ""}
    mx, crit = limite_do_sensor(fontes["cpu"])
    if crit and "coretemp" in (ler(os.path.dirname(fontes["cpu"] or "") + "/name") or ""):
        r["temp_cpu"], fonte["temp_cpu"] = [round(crit) - 15, round(crit) - 8, round(crit) - 3], "Tjmax %d" % crit
    else:
        tj = tjmax_amd(NOME_CPU)
        r["temp_cpu"], fonte["temp_cpu"] = [tj - 10, tj - 5, tj - 1], "Tjmax %d" % tj
    g = hw_lim["gpu"] or {}
    if g.get("max") and g.get("lento") and g["lento"] > g["max"]:
        r["temp_gpu"], fonte["temp_gpu"] = [g["max"] - 8, g["max"], g["lento"]], "max %d, slowdown %d" % (g["max"], g["lento"])
    elif g.get("crit"):
        r["temp_gpu"], fonte["temp_gpu"] = [g["crit"] - 20, g["crit"] - 10, g["crit"] - 3], "crit %d" % g["crit"]
    else:
        r["temp_gpu"] = [80, 85, 90]
    crits = [c for c in (limite_do_sensor(m)[1] for m in fontes["mem"]) if c]
    if crits:
        c = round(min(crits))
        r["temp_mem"], fonte["temp_mem"] = [c - 20, c - 10, c - 3], "crit %d" % c
    else:
        r["temp_mem"] = [60, 70, 80]
    ssd = {"_": [65, 72, 80]}
    for d in discos:
        mx, crit = limite_do_sensor(d.get("temp_arq"))
        if mx and crit and crit > mx:
            ssd[d["nome"]] = [round(mx) - 8, round(mx), round(crit)]
        elif mx:
            ssd[d["nome"]] = [round(mx) - 8, round(mx) - 3, round(mx)]
        elif crit:
            ssd[d["nome"]] = [round(crit) - 15, round(crit) - 8, round(crit) - 2]
    r["temp_ssd"] = ssd
    r["fonte"] = fonte
    rec_cache.update(t=time.monotonic(), v=r)
    return r


def recomendados_jogo():
    # while a game runs a full graphics card and a busy processor are expected:
    # only warn when it is about to run out
    return dict(recomendados(), vram=[95, 98, None], cpu_uso=[95, 99, None], prog_cpu=[90, 98, None])


def jogando():
    return bool(cfg["jogo"]["limites"] and extra["jogos"])


def silenciado(ident, t=None):
    t = t or time.time()
    return silencio.get(ident, 0) > t or silencio.get("*", 0) > t


def ler_int_meminfo(chave):
    m = re.search(r"^%s:\s+(\d+)" % chave, ler("/proc/meminfo") or "", re.M)
    return int(m.group(1)) if m else 0


def limite(mid, disco=None):
    # the thresholds in force for one alert, or None when that alert is off
    c = cfg["limites"][mid]
    if not c["on"]:
        return None
    rec = recomendados
    if mid in cfg["limites_jogo"] and jogando():
        c, rec = cfg["limites_jogo"][mid], recomendados_jogo
    if c["rec"] or not c.get("v"):
        r = rec()[mid]
        return (r.get(disco) or r["_"]) if mid == "temp_ssd" else r
    return c["v"]


def rodar(args, espera=10):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=espera,
                              env=dict(os.environ, LC_ALL="C")).stdout
    except (OSError, subprocess.SubprocessError):
        return None


BOOT = int(re.search(r"^btime (\d+)", ler("/proc/stat") or "btime 0", re.M).group(1))
NOME_CPU = re.sub(r"^AMD |^Intel\(R\) Core\(TM\) | \d+-Core Processor.*$", "",
                  (re.search(r"model name\s*:\s*(.+)", ler("/proc/cpuinfo") or "") or [None, "Processador"])[1]).strip()
FREQS = sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq"))
# processor package energy (RAPL, also on AMD). Most systems keep it readable by root only,
# then the processor power is simply not shown.
RAPL = next((x for x in sorted(glob.glob("/sys/class/powercap/intel-rapl:[0-9]/energy_uj")) if os.access(x, os.R_OK)), None)
