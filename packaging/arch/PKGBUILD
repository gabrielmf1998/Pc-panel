# Maintainer: PC Panel contributors
pkgname=pc-panel
pkgver=0.5.2
pkgrel=1
pkgdesc="Local web dashboard to monitor and control a Linux PC (RAM, VRAM, CPU, network, disks, fans), with a tray icon"
arch=('x86_64' 'aarch64')
url="https://github.com/gabrielmf1998/pc-panel"
license=('MIT')
depends=('python>=3.12' 'systemd' 'systemd-libs' 'glibc')
optdepends=('nvidia-utils: NVIDIA graphics card readings and fan control'
            'fakeroot: check for pending system updates'
            'flatpak: count pending Flatpak updates'
            'kdialog: port dialog of the tray icon on KDE'
            'zenity: port dialog of the tray icon')
install=pc-panel.install
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    make
}

package() {
    cd "$pkgname-$pkgver"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}
