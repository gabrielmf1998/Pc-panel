post_install() {
    echo ">>> Open PC Panel from the application menu (or run pc-panel-tray)."
    echo ">>> The monitor icon in the tray starts the dashboard at http://127.0.0.1:47822"
    echo ">>> and has: Change port, Start with system, Quit."
    echo ">>> Optional fan control:  sudo /usr/lib/pc-panel/pc-panel-fans --allow \$USER"
    echo ">>>                        sudo systemctl enable --now pc-panel-fans.path && sudo systemctl enable pc-panel-fans.service"
}
post_upgrade() {
    echo ">>> A running PC Panel tray icon reloads itself and the dashboard."
}
pre_remove() {
    systemctl disable --now pc-panel-fans.path pc-panel-fans.service 2>/dev/null || true
}
